---
import '../styles/global.css';
import { site, nav } from '../data/site';
interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const pageDescription = description ?? site.description;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <!-- 主题初始化：默认浅色，只有存过“dark”才进深色（防止刷新闪一下） -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header" id="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          {site.name}<span class="brand-dot">.</span>
        </a>

        <nav class="nav" id="site-nav">
          {
            nav.map((item) => (
              <a class="nav-link" href={item.href}>{item.label}</a>
            ))
          }
          <div class="nav-tools">
            <a class="icon-btn" href="/search" aria-label="搜索" title="搜索">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </a>
            <button class="icon-btn" id="theme-toggle" aria-label="切换主题" title="切换主题">
              <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
              <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"></circle>
                <line x1="12" y1="2" x2="12" y2="5"></line>
                <line x1="12" y1="19" x2="12" y2="22"></line>
                <line x1="2" y1="12" x2="5" y2="12"></line>
                <line x1="19" y1="12" x2="22" y2="12"></line>
                <line x1="4.9" y1="4.9" x2="6.3" y2="6.3"></line>
                <line x1="17.7" y1="17.7" x2="19.1" y2="19.1"></line>
                <line x1="4.9" y1="19.1" x2="6.3" y2="17.7"></line>
                <line x1="17.7" y1="6.3" x2="19.1" y2="4.9"></line>
              </svg>
            </button>
          </div>
        </nav>

        <!-- 汉堡按钮必须放在 <nav> 外面：移动端 nav 整块是隐藏的浮层，
             放里面会跟着一起被藏起来，导致菜单永远打不开 -->
        <button class="icon-btn nav-toggle" id="nav-toggle" aria-label="菜单" aria-expanded="false">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-left">
          <span class="footer-copy">© {new Date().getFullYear()} {site.name}</span>
        </div>
        <div class="footer-links">
          <a class="icon-btn" href={site.links.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
          </a>
          <a class="icon-btn" href={site.links.email} aria-label="邮箱" title="邮箱">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-10 6L2 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </footer>

    <!-- 访客信息固定在最底部的小条：所有页面都常驻显示（含照片墙页） -->
    <div class="footer-bar" aria-label="网站访问统计">
      <span>已被访问 <b data-visit="site_pv">—</b> 次 · <b data-visit="site_uv">—</b> 位访客</span>
    </div>

    <script>
      // 主题切换（默认浅色；点一下变深色，再点回浅色）
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const html = document.documentElement;
        const next = html.getAttribute('data-theme') === 'dark' ? '' : 'dark';
        if (next) {
          html.setAttribute('data-theme', next);
        } else {
          html.removeAttribute('data-theme');
        }
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      });

      // 可点击区域的动态效果：每次鼠标悬停/触摸都随机一个新的颜色
      // （hover 时元素会轻微浮起/放大 + 变成这个随机颜色，见 global.css 的 [data-hov] 规则）
      const hoverPalette = [
        '#4f8cff',
        '#7c5cfc',
        '#00b894',
        '#fd79a8',
        '#e17055',
        '#00cec9',
        '#6ab04c',
        '#ff9f43',
      ];
      document.querySelectorAll('a, button').forEach((el) => {
        if (
          el.classList.contains('brand') ||
          el.classList.contains('lightbox-btn') ||
          el.classList.contains('pw-btn')
        )
          return;
        el.setAttribute('data-hov', '');
        el.addEventListener('mouseenter', () => {
          // 每次进入都重新随机，而不是刷新页面才变
          el.style.setProperty(
            '--hov-c',
            hoverPalette[Math.floor(Math.random() * hoverPalette.length)]
          );
        });
      });

      // 移动端菜单
      const navToggle = document.getElementById('nav-toggle');
      const siteNav = document.getElementById('site-nav');
      const closeNav = () => {
        siteNav?.classList.remove('open');
        navToggle?.setAttribute('aria-expanded', 'false');
      };
      navToggle?.addEventListener('click', () => {
        const open = siteNav?.classList.toggle('open');
        navToggle.setAttribute('aria-expanded', String(!!open));
      });
      // 点链接后收起菜单
      siteNav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeNav));

      // 顶栏：往下滑变白色浮卡 + 继续下滑自动收起，往回滑再落下来
      const header = document.getElementById('site-header');
      let lastY = window.scrollY;
      let ticking = false;

      const onScroll = () => {
        ticking = false;
        if (!header) return;
        const y = window.scrollY;

        // 离开顶部 12px 就变成卡片（透明 → 白底描边阴影）
        header.classList.toggle('is-scrolled', y > 12);

        // 超过 320px 且还在往下滑 → 收起；往回滑或回到顶部附近 → 出现
        if (y > 320 && y > lastY + 2) {
          if (!header.classList.contains('is-hidden')) {
            header.classList.add('is-hidden');
            closeNav();
          }
        } else if (y < lastY - 2 || y <= 320) {
          header.classList.remove('is-hidden');
        }

        lastY = y;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(onScroll);
          }
        },
        { passive: true }
      );
      onScroll();

      // 访问量：vercount（不蒜子替代）的公开接口，静态博客不需要自建后端
      // —— 「自己的浏览器不计数」（私密方式，页面上没有任何开关）
      // 用带私密 token 的网址访问一次，本浏览器就永久不再上报。例如：
      //   https://takinol.github.io/?nl=xk9T4mQ2
      // 这个 token 只写在代码里，页面不显示；把它当成你自己的"钥匙"保管好。
      const NOCOUNT_KEY = 'takinol:nocount';
      const NOCOUNT_TOKEN = 'xk9T4mQ2';
      const nologParams = new URLSearchParams(location.search);
      if (nologParams.get('nl') === NOCOUNT_TOKEN) {
        try {
          localStorage.setItem(NOCOUNT_KEY, '1');
        } catch (e) {}
        nologParams.delete('nl');
        const qs = nologParams.toString();
        history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
      }
      let noCount = false;
      try {
        noCount = localStorage.getItem(NOCOUNT_KEY) === '1';
      } catch (e) {}

      const visitEls = Array.from(document.querySelectorAll<HTMLElement>('[data-visit]'));
      if (visitEls.length) {
        const host = location.hostname;
        const isLocal = !host || host === 'localhost' || host === '127.0.0.1';
        const cacheKey = 'takinol:visits:v1:' + location.pathname;

        const fill = (data: Record<string, number>) => {
          visitEls.forEach((el) => {
            const v = data[el.dataset.visit || ''];
            if (typeof v === 'number' && Number.isFinite(v)) {
              el.textContent = v.toLocaleString('zh-CN');
            }
          });
        };

        // 先拿上一次缓存顶上，避免数字从「—」跳变
        try {
          const cached = localStorage.getItem(cacheKey);
          if (cached) fill(JSON.parse(cached));
        } catch (e) {}

        // 本机标记了「不统计」就不上报（也不写访客 cookie）
        if (!isLocal && !noCount) {
          const uvCookie = 'takinol_uv';
          const seen = document.cookie.split('; ').some((c) => c.startsWith(uvCookie + '='));
          if (!seen) {
            document.cookie = uvCookie + '=1; path=/; max-age=31536000; samesite=lax';
          }

          fetch('https://events.vercount.one/api/v2/log', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              url: location.origin + location.pathname,
              isNewUv: !seen,
            }),
          })
            .then((r) => (r.ok ? r.json() : null))
            .then((res) => {
              const data = res?.data ?? res;
              if (data && typeof data.site_pv === 'number') {
                fill(data);
                try {
                  localStorage.setItem(cacheKey, JSON.stringify(data));
                } catch (e) {}
              }
            })
            .catch(() => {
              /* 统计服务挂了就不显示数字，不影响页面 */
            });
        }
      }
    </script>
  </body>
</html>
