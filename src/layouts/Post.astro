---
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
interface Props {
  title: string;
  date: Date;
  tags?: string[];
  description?: string;
  // 阅读时长（分钟），由文章正文估算后传进来
  minutes?: number;
}
const { title, date, tags = [], description, minutes } = Astro.props;
const fmt = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={title} description={description}>
  <div class="container page-wrap">
    <article class="toc-content post-article">
      <a class="back-link" href="/blog">← 返回文章列表</a>

      <!-- 文章信息行：日期 / 阅读时长 / 阅读量 / 标签，放在标题上方 -->
      <div class="post-meta">
        <span class="meta-item">
          <svg class="meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <time datetime={date.toISOString()}>{fmt.format(date)}</time>
        </span>

        {
          minutes && (
            <span class="meta-item">
              <svg class="meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <polyline points="12 7 12 12 15.5 14"></polyline>
              </svg>
              <span>约 {minutes} 分钟</span>
            </span>
          )
        }

        <span class="meta-item">
          <svg class="meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
          <span>本篇 <span data-visit="page_pv">—</span> 次阅读</span>
        </span>

        {
          tags.length > 0 && (
            <span class="meta-item meta-tags">
              <svg class="meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="4" y1="9" x2="20" y2="9"></line>
                <line x1="4" y1="15" x2="20" y2="15"></line>
                <line x1="10" y1="3" x2="8" y2="21"></line>
                <line x1="16" y1="3" x2="14" y2="21"></line>
              </svg>
              {tags.map((tag, i) => (
                <span>
                  {tag}
                  {i < tags.length - 1 && <span class="meta-sep">/</span>}
                </span>
              ))}
            </span>
          )
        }
      </div>

      <h1>{title}</h1>

      {description && <p class="post-desc">“{description}”</p>}

      <div class="post-divider"></div>

      <div class="prose">
        <slot />
      </div>
    </article>
    <aside class="toc-col">
      <Toc />
    </aside>
  </div>
  <ReadingProgress />
</Base>

<script>
  // 宽表格（比如实验指标表）在手机上会把整页撑出横向滚动条，
  // 给它套一个可横向滚动的壳，让表格自己滚、页面不动
  document.querySelectorAll('.prose table').forEach((table) => {
    const parent = table.parentElement;
    if (!parent || parent.classList.contains('table-wrap')) return;
    const wrap = document.createElement('div');
    wrap.className = 'table-wrap';
    parent.insertBefore(wrap, table);
    wrap.appendChild(table);
  });
</script>
