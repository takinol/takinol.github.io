---
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import { site } from '../data/site';
interface Props {
  title: string;
  date: Date;
  tags?: string[];
  description?: string;
}
const { title, date, tags = [], description } = Astro.props;
const fmt = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={title} description={description}>
  <div class="container page-wrap">
    <article class="toc-content post-article">
      <a class="back-link" href="/blog">← 返回文章列表</a>
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{fmt.format(date)}</time>
        {
          tags.map((tag) => <span class="tag">{tag}</span>)
        }
      </div>
      <div class="prose">
        <slot />
      </div>
    </article>
    <aside class="toc-col">
      <Toc />
    </aside>
  </div>
</Base>
