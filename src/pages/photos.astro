---
import Base from '../layouts/Base.astro';
import { readdirSync } from 'node:fs';
import { join } from 'node:path';

// 照片墙内容 = public/photos/ 文件夹里的所有图片
// （构建时 cwd 就是仓库根目录，所以从这里读 public/photos 是可靠的）
const photosDir = join(process.cwd(), 'public', 'photos');
const files = readdirSync(photosDir)
  .filter((f) => /\.(jpe?g|png|gif|webp)$/i.test(f))
  .sort((a, b) => a.localeCompare(b, 'zh-Hans-CN'))
  .map((f) => ({
    src: '/photos/' + encodeURI(f),
    name: f.replace(/\.[^.]+$/, ''),
  }));
---

<Base title="照片" description="小猫的照片墙">
  <header class="page-head photos-head">
    <div class="container" style="text-align: center">
      <h1>照片</h1>
      <p class="photos-hint">可以随意拖动照片 · 点一下放大</p>
    </div>
  </header>

  <div class="wall" id="wall">
    {
      files.length === 0 ? (
        <p class="wall-empty">
          还没有照片。
          <br />
          把图片放进 <code>public/photos/</code> 文件夹，刷新就有了。
        </p>
      ) : (
        files.map((p, i) => (
          <figure class="photo" data-name={p.name} style={`--i:${i}`}>
            <img src={p.src} alt={p.name} loading="lazy" draggable="false" />
            <figcaption>{p.name}</figcaption>
          </figure>
        ))
      )
    }
  </div>

  <!-- 点击放大查看层 -->
  <div class="lightbox" id="lightbox" aria-hidden="true">
    <div class="lightbox-backdrop" data-close></div>
    <button class="lightbox-btn lightbox-close" data-close aria-label="关闭" title="关闭">×</button>
    <button class="lightbox-btn lightbox-prev" data-prev aria-label="上一张" title="上一张">‹</button>
    <button class="lightbox-btn lightbox-next" data-next aria-label="下一张" title="下一张">›</button>
    <figure class="lightbox-figure">
      <img class="lightbox-img" id="lightbox-img" src="" alt="" />
      <figcaption class="lightbox-cap" id="lightbox-cap"></figcaption>
    </figure>
  </div>
</Base>

<style>
  /* 页头 */
  .photos-head {
    padding-top: 40px;
    padding-bottom: 6px;
  }

  .photos-hint {
    color: var(--text-faint);
    font-size: 14px;
    margin-top: 8px;
  }

  /* 照片墙画布：占满剩余视口高度，照片在里面随便拖 */
  .wall {
    position: relative;
    height: calc(100dvh - 60px - 150px);
    min-height: 400px;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px 40px;
    overflow: hidden;
  }

  .wall-empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
    color: var(--text-faint);
    text-align: center;
    line-height: 1.8;
  }

  .wall-empty code {
    font-family: var(--font-mono);
    background: var(--code-bg);
    border-radius: 6px;
    padding: 2px 6px;
  }

  /* 一张照片 = 一个小相框 */
  .photo {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    width: clamp(130px, 22vw, 190px);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 8px 8px 9px;
    box-shadow: 0 10px 28px -14px rgba(15, 20, 40, 0.35);
    cursor: grab;
    user-select: none;
    -webkit-user-drag: none;
    touch-action: none;
    will-change: transform;
    transform: translate(var(--x, 0px), var(--y, 0px)) rotate(var(--rot, 0deg));
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.2s ease;
    opacity: 0;
  }

  .photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    pointer-events: none;
  }

  .photo figcaption {
    font-size: 12px;
    color: var(--text-faint);
    text-align: center;
    margin-top: 7px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 入场：渐现 + 轻微上浮，逐张错开 */
  .photo.in {
    opacity: 1;
    animation: photoIn 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    animation-delay: calc(var(--i) * 60ms);
  }

  @keyframes photoIn {
    from {
      opacity: 0;
      transform: translate(calc(var(--x, 0px)), calc(var(--y, 0px) + 36px)) rotate(0deg)
        scale(0.72);
    }
    to {
      opacity: 1;
      transform: translate(var(--x, 0px), var(--y, 0px)) rotate(var(--rot, 0deg)) scale(1);
    }
  }

  .photo:hover {
    z-index: 60;
  }

  .photo.dragging {
    cursor: grabbing;
    box-shadow: 0 22px 48px -16px rgba(15, 20, 40, 0.45);
    transition: none;
  }

  /* ---------- 点击放大查看层 ---------- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .lightbox.show {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 10, 20, 0.8);
    backdrop-filter: blur(8px);
  }

  .lightbox-figure {
    position: relative;
    max-width: 92vw;
    max-height: 86vh;
    margin: 0;
    text-align: center;
  }

  .lightbox-img {
    display: block;
    max-width: 92vw;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .lightbox-cap {
    color: rgba(255, 255, 255, 0.85);
    text-align: center;
    margin-top: 14px;
    font-size: 14px;
  }

  .lightbox-btn {
    position: absolute;
    z-index: 3;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .lightbox-btn:hover {
    background: rgba(255, 255, 255, 0.26);
  }

  .lightbox-close {
    top: 18px;
    right: 18px;
    font-size: 26px;
  }

  .lightbox-prev {
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
  }

  /* 窄屏 */
  @media (max-width: 640px) {
    .wall {
      height: calc(100dvh - 60px - 130px);
    }
    .photo {
      width: clamp(110px, 40vw, 160px);
    }
  }
</style>

<script>
  const wall = document.getElementById('wall');
  const photos = Array.from(wall?.querySelectorAll('.photo') ?? []);
  if (photos.length) {
    // 固定种子的伪随机：每次刷新位置基本一致，不会乱跳
    function mulberry32(seed: number) {
      return function () {
        seed |= 0;
        seed = (seed + 0x6d2b79f5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    const rand = mulberry32(20261017);

    // 1) 散开摆放：随机位置 + 随机角度
    const w = wall.clientWidth;
    const h = wall.clientHeight;
    photos.forEach((el, i) => {
      const pw = el.offsetWidth;
      const ph = el.offsetHeight;
      const x = rand() * Math.max(0, w - pw);
      const y = rand() * Math.max(0, h - ph);
      const rot = (rand() - 0.5) * 24;
      el.style.setProperty('--x', x.toFixed(1) + 'px');
      el.style.setProperty('--y', y.toFixed(1) + 'px');
      el.style.setProperty('--rot', rot.toFixed(1) + 'deg');
      el.classList.add('in');
    });

    // 2) 拖拽 + 点击放大
    let zTop = 10;
    const bringToFront = (el: HTMLElement) => {
      zTop += 1;
      el.style.zIndex = String(zTop);
    };

    photos.forEach((el: HTMLElement) => {
      let dragging = false;
      let moved = false;
      let startX = 0,
        startY = 0,
        baseX = 0,
        baseY = 0;

      const getX = () => parseFloat(el.style.getPropertyValue('--x')) || 0;
      const getY = () => parseFloat(el.style.getPropertyValue('--y')) || 0;

      el.addEventListener('pointerdown', (e) => {
        dragging = true;
        moved = false;
        startX = e.clientX;
        startY = e.clientY;
        baseX = getX();
        baseY = getY();
        el.setPointerCapture(e.pointerId);
        el.classList.add('dragging');
        bringToFront(el);
      });

      el.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        if (Math.abs(dx) + Math.abs(dy) > 4) moved = true;
        if (moved) {
          el.style.transform = `translate(${baseX + dx}px, ${baseY + dy}px) rotate(${
            el.style.getPropertyValue('--rot') || '0deg'
          })`;
        }
      });

      const endDrag = (e: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        el.classList.remove('dragging');
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        if (moved) {
          // 落定：更新基准位置，清掉拖拽中的内联 transform，让过渡平滑归位
          el.style.setProperty('--x', (baseX + dx).toFixed(1) + 'px');
          el.style.setProperty('--y', (baseY + dy).toFixed(1) + 'px');
          el.style.transform = '';
        } else {
          openLightbox(el);
        }
      };
      el.addEventListener('pointerup', endDrag);
      el.addEventListener('pointercancel', endDrag);
    });

    // 3) 大图查看
    const lightbox = document.getElementById('lightbox') as HTMLElement;
    const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lbCap = document.getElementById('lightbox-cap') as HTMLElement;
    let current = -1;

    const openLightbox = (el: HTMLElement) => {
      current = photos.indexOf(el);
      show();
    };

    const show = () => {
      const el = photos[current];
      lbImg.src = (el.querySelector('img') as HTMLImageElement).src;
      lbCap.textContent = el.dataset.name || '';
      lbImg.style.transition = 'none';
      lbImg.style.opacity = '0';
      lbImg.style.transform = 'scale(0.92)';
      lightbox.classList.add('show');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        lbImg.style.transition = '';
        lbImg.style.opacity = '1';
        lbImg.style.transform = 'scale(1)';
      });
    };

    const closeLightbox = () => {
      lightbox.classList.remove('show');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    const step = (d: number) => {
      current = (current + d + photos.length) % photos.length;
      const el = photos[current];
      lbImg.style.transition = 'none';
      lbImg.style.opacity = '0';
      lbImg.style.transform = 'scale(0.96)';
      requestAnimationFrame(() => {
        lbImg.src = (el.querySelector('img') as HTMLImageElement).src;
        lbCap.textContent = el.dataset.name || '';
        requestAnimationFrame(() => {
          lbImg.style.transition = '';
          lbImg.style.opacity = '1';
          lbImg.style.transform = 'scale(1)';
        });
      });
    };

    lightbox.querySelectorAll('[data-close]').forEach((btn) =>
      btn.addEventListener('click', closeLightbox)
    );
    lightbox.querySelector('[data-prev]')?.addEventListener('click', () => step(-1));
    lightbox.querySelector('[data-next]')?.addEventListener('click', () => step(1));
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('show')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
  }
</script>
