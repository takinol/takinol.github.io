---
import Base from '../layouts/Base.astro';
import { readdirSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { photoNotes } from '../data/photos';

// 照片墙内容 = public/photos/ 文件夹里的所有图片
// （构建时 cwd 就是仓库根目录，所以从这里读 public/photos 是可靠的）
const photosDir = join(process.cwd(), 'public', 'photos');

// 读图片文件头拿宽高（png/jpg/gif/webp），不需要额外依赖
function imageSize(filePath: string): { w: number; h: number } | null {
  try {
    const buf = readFileSync(filePath);
    if (buf.length < 24) return null;
    // PNG
    if (buf[0] === 0x89 && buf[1] === 0x50) {
      return { w: buf.readUInt32BE(16), h: buf.readUInt32BE(20) };
    }
    // GIF
    if (buf[0] === 0x47 && buf[1] === 0x49) {
      return { w: buf.readUInt16LE(6), h: buf.readUInt16LE(8) };
    }
    // WebP
    if (buf[0] === 0x52 && buf[1] === 0x49 && buf[2] === 0x46 && buf[3] === 0x46) {
      const chunk = buf.toString('ascii', 12, 16);
      if (chunk === 'VP8X') return { w: 1 + buf.readUIntLE(24, 3), h: 1 + buf.readUIntLE(27, 3) };
      if (chunk === 'VP8 ') return { w: buf.readUInt16LE(26) & 0x3fff, h: buf.readUInt16LE(28) & 0x3fff };
      if (chunk === 'VP8L') {
        const b = buf.readUInt32LE(21);
        return { w: (b & 0x3fff) + 1, h: ((b >> 14) & 0x3fff) + 1 };
      }
    }
    // JPEG：扫 SOF 标记
    let i = 2;
    while (i < buf.length - 9) {
      if (buf[i] !== 0xff) { i++; continue; }
      const marker = buf[i + 1];
      if (marker === 0xd8 || marker === 0xff) { i++; continue; }
      if (marker >= 0xc0 && marker <= 0xcf && marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc) {
        return { h: buf.readUInt16BE(i + 5), w: buf.readUInt16BE(i + 7) };
      }
      i += 2 + buf.readUInt16BE(i + 2);
    }
  } catch {
    return null;
  }
  return null;
}

const files = readdirSync(photosDir)
  .filter((f) => /\.(jpe?g|png|gif|webp)$/i.test(f))
  .sort((a, b) => a.localeCompare(b, 'zh-Hans-CN'))
  .map((f) => {
    const base = f.replace(/\.[^.]+$/, '');
    const size = imageSize(join(photosDir, f));
    // 按图片长宽比决定显示大小：竖图窄、横图宽、方图适中（都有限制，不会太大）
    let sz: 's' | 'm' | 'l' = 'm';
    if (size) {
      const aspect = size.w / size.h;
      if (aspect < 0.7) sz = 's';
      else if (aspect > 1.45) sz = 'l';
    }
    return {
      src: '/photos/' + encodeURI(f),
      name: base,
      note: photoNotes[base] ?? '',
      sz,
    };
  });
---

<Base title="照片" description="小猫的照片墙">
  <!-- 背景涂鸦层：美式街头涂鸦元素 × 孟菲斯配色，随机散落 + 随机浮动 -->
  <div class="graffiti-bg" id="graffiti-bg" aria-hidden="true">
    <span class="gz gz-splat" style="color: var(--pink)"></span>
    <span class="gz gz-splat" style="color: var(--blue); --gsz: 64px"></span>
    <span class="gz gz-splat" style="color: var(--lime); --gsz: 76px"></span>
    <span class="gz gz-star outline" style="color: var(--yellow)"></span>
    <span class="gz gz-star outline" style="color: var(--pink); --gsz: 24px"></span>
    <span class="gz gz-star" style="color: var(--blue); --gsz: 30px"></span>
    <span class="gz gz-arrow" style="color: var(--yellow)"></span>
    <span class="gz gz-arrow" style="color: var(--lime); --gsz: 52px"></span>
    <span class="gz gz-bubble" style="color: var(--pink)"></span>
    <span class="gz gz-bubble" style="color: var(--blue); --gsz: 34px"></span>
    <span class="gz gz-bubble" style="color: var(--yellow); --gsz: 56px"></span>
    <span class="gz gz-tagline" style="color: var(--pink)"></span>
    <span class="gz gz-tagline" style="color: var(--blue); --gsz: 64px"></span>
    <span class="gz gz-crown" style="color: var(--yellow)"></span>
    <span class="gz gz-crown" style="color: var(--pink); --gsz: 30px"></span>
  </div>
  <div class="wall" id="wall">
    <div class="wall-title"></div>
    {
      files.length === 0 ? (
        <p class="wall-empty">
          还没有照片。
          <br />
          把图片放进 <code>public/photos/</code> 文件夹，刷新就有了。
        </p>
      ) : (
        files.map((p, i) => (
          <figure
            class={`photo w-${p.sz}`}
            data-name={p.name}
            data-note={p.note}
            style={`--i:${i}`}
          >
            <img src={p.src} alt={p.name} loading="lazy" draggable="false" />
            <figcaption>{p.name}</figcaption>
          </figure>
        ))
      )
    }
  </div>

  <!-- 点击放大查看层 -->
  <div class="lightbox" id="lightbox" aria-hidden="true">
    <div class="lightbox-backdrop" data-close></div>
    <button class="lightbox-btn lightbox-close" data-close aria-label="关闭" title="关闭">×</button>
    <button class="lightbox-btn lightbox-prev" data-prev aria-label="上一张" title="上一张">‹</button>
    <button class="lightbox-btn lightbox-next" data-next aria-label="下一张" title="下一张">›</button>

    <div class="lightbox-stage" id="lightbox-stage">
      <img class="lightbox-img" id="lightbox-img" src="" alt="" />
      <figcaption class="lightbox-cap" id="lightbox-cap"></figcaption>
    </div>
    <div class="sticky-note" id="lightbox-note"></div>
  </div>
</Base>

<style>
  /* ---------- 背景美式涂鸦元素（孟菲斯配色）----------
     喷漆泼溅 / 涂鸦星星 / 街头箭头 / 气泡圈 / 涂鸦线
     随机散落 + 各自随机浮动，JS 只负责随机摆放和浮动参数 */
  .graffiti-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .gz {
    position: absolute;
    left: var(--gx);
    top: var(--gy);
    opacity: var(--go, 0.5);
    animation: gzFloat var(--gdur, 6s) ease-in-out var(--gdelay, 0s) infinite alternate;
  }
  /* 每个元素浮动轨迹不同：主动画上下飘，::after 反向左右飘，合成随机漂移感 */
  @keyframes gzFloat {
    from {
      transform: translate(0, 0) rotate(var(--grot, 0deg)) scale(1);
    }
    to {
      transform: translate(var(--gdx, 0px), var(--gdy, 14px)) rotate(calc(var(--grot, 0deg) + var(--gspin, 8deg)))
        scale(var(--gscale, 1.06));
    }
  }
  /* 孟菲斯色卡变量 */
  .gz {
    --pink: #de0c62;
    --blue: #2242c7;
    --yellow: #ffdf22;
    --lime: #9acd32;
  }

  /* 1) 喷漆泼溅：一大一小两团喷点 + 飞沫（radial-gradient 堆叠） */
  .gz-splat {
    width: var(--gsz, 90px);
    height: var(--gsz, 90px);
    background:
      radial-gradient(circle at 50% 50%, currentColor 0 34%, transparent 36%),
      radial-gradient(circle at 78% 24%, currentColor 0 9%, transparent 11%),
      radial-gradient(circle at 16% 72%, currentColor 0 7%, transparent 9%),
      radial-gradient(circle at 70% 82%, currentColor 0 5%, transparent 7%),
      radial-gradient(circle at 88% 60%, currentColor 0 4%, transparent 6%),
      radial-gradient(circle at 30% 12%, currentColor 0 3.5%, transparent 5.5%),
      radial-gradient(circle at 12% 34%, currentColor 0 3%, transparent 5%),
      radial-gradient(circle at 58% 6%, currentColor 0 2.5%, transparent 4.5%);
    filter: blur(0.4px); /* 喷漆的轻微雾边 */
  }
  .gz-splat::after {
    /* 喷漆罐拖尾 */
    content: '';
    position: absolute;
    right: -46%;
    top: 30%;
    width: 46%;
    height: 10%;
    border-radius: 50%;
    background: currentColor;
    transform: rotate(-24deg);
    opacity: 0.45;
  }

  /* 2) 涂鸦星星（街头四角星 sparkle） */
  .gz-star {
    width: var(--gsz, 34px);
    height: var(--gsz, 34px);
    background: currentColor;
    clip-path: polygon(
      50% 0%,
      61% 39%,
      100% 50%,
      61% 61%,
      50% 100%,
      39% 61%,
      0% 50%,
      39% 39%
    );
  }
  /* 涂鸦星星常带黑色描边感 —— 用双层：外层深色偏移 */
  .gz-star.outline::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #070d0d;
    clip-path: inherit;
    transform: translate(2.5px, 2.5px);
    z-index: -1;
  }

  /* 3) 街头箭头（graffiti arrow）：粗描边折角箭头 */
  .gz-arrow {
    width: var(--gsz, 70px);
    height: calc(var(--gsz, 70px) * 0.62);
    background: currentColor;
    clip-path: polygon(
      0% 55%,
      55% 55%,
      55% 25%,
      100% 62%,
      55% 100%,
      55% 70%,
      0% 70%
    );
    filter: drop-shadow(2.5px 2.5px 0 #070d0d); /* 涂鸦黑描边 */
  }

  /* 4) 气泡圈（throw-up 气泡字母的抽象圆环）：粗环 + 黑描边 */
  .gz-bubble {
    width: var(--gsz, 46px);
    height: var(--gsz, 46px);
    border-radius: 50%;
    border: calc(var(--gsz, 46px) * 0.24) solid currentColor;
    filter: drop-shadow(2px 3px 0 #070d0d);
  }

  /* 5) 涂鸦波浪签线（tag squiggle）：粗笔刷曲线 */
  .gz-tagline {
    width: var(--gsz, 80px);
    height: calc(var(--gsz, 80px) * 0.3);
    background: radial-gradient(circle at 6px -3px, transparent 7px, currentColor 7.5px, currentColor 12.5px, transparent 13px);
    background-size: 18px 18px;
    filter: drop-shadow(1.5px 2px 0 #070d0d);
  }

  /* 6) 皇冠（涂鸦之王 crown，街头常见 tag 符号） */
  .gz-crown {
    width: var(--gsz, 40px);
    height: calc(var(--gsz, 40px) * 0.72);
    background: currentColor;
    clip-path: polygon(
      0% 100%,
      8% 30%,
      30% 62%,
      50% 0%,
      70% 62%,
      92% 30%,
      100% 100%
    );
    filter: drop-shadow(2px 2.5px 0 #070d0d);
  }

  @media (max-width: 640px) {
    .gz {
      opacity: calc(var(--go, 0.5) * 0.6); /* 手机上更淡 */
    }
  }

  /* 左上角的标题 */
  .wall-title {
    position: absolute;
    top: 22px;
    left: 26px;
    z-index: 2;
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 700;
    color: var(--text);
    pointer-events: none;
  }

  /* 照片墙画布：铺满整个屏幕（顶部导航下面到页面底部），照片在里面随便拖 */
  .wall {
    position: fixed;
    top: 60px;
    left: 0;
    right: 0;
    bottom: 56px;
    z-index: 1;
    overflow: hidden;
    /* 放大照片时把整面墙高斯模糊掉 */
    transition: filter 0.35s ease;
  }

  .wall.blurred {
    filter: blur(22px) brightness(0.9);
  }

  .wall-empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
    color: var(--text-faint);
    text-align: center;
    line-height: 1.8;
  }

  .wall-empty code {
    font-family: var(--font-mono);
    background: var(--code-bg);
    border-radius: 6px;
    padding: 2px 6px;
  }

  /* 一张照片 = 一个小相框。宽度按长宽比分三档，竖图/横图/方图不一样大 */
  .photo {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    width: var(--pw, 190px);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 8px 8px 9px;
    box-shadow: 0 10px 28px -14px rgba(15, 20, 40, 0.35);
    cursor: grab;
    user-select: none;
    -webkit-user-drag: none;
    touch-action: none;
    will-change: transform;
    transform: translate(var(--x, 0px), var(--y, 0px)) rotate(var(--rot, 0deg));
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.2s ease;
    opacity: 0;
  }

  .photo.w-s {
    --pw: clamp(100px, 15vw, 150px);
  }
  .photo.w-m {
    --pw: clamp(140px, 21vw, 190px);
  }
  .photo.w-l {
    --pw: clamp(170px, 30vw, 250px);
  }

  .photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    pointer-events: none;
  }

  .photo figcaption {
    font-size: 12px;
    color: var(--text-faint);
    text-align: center;
    margin-top: 7px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 入场：渐现 + 轻微上浮，逐张错开 */
  .photo.in {
    opacity: 1;
    animation: photoIn 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    animation-delay: calc(var(--i) * 60ms);
  }

  @keyframes photoIn {
    from {
      opacity: 0;
      transform: translate(calc(var(--x, 0px)), calc(var(--y, 0px) + 36px)) rotate(0deg)
        scale(0.72);
    }
    to {
      opacity: 1;
      transform: translate(var(--x, 0px), var(--y, 0px)) rotate(var(--rot, 0deg)) scale(1);
    }
  }

  .photo:hover {
    z-index: 60;
  }

  .photo.dragging {
    cursor: grabbing;
    box-shadow: 0 22px 48px -16px rgba(15, 20, 40, 0.45);
    transition: none;
  }

  /* ---------- 点击放大查看层 ---------- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .lightbox.show {
    opacity: 1;
    visibility: visible;
  }

  /* 背景层：只是点空白处关闭用的透明层，模糊由 .wall.blurred 负责 */
  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: transparent;
  }

  /* 舞台：飞入/飞出动画作用在这层，宽高由 JS 按图片实际比例设置 */
  .lightbox-stage {
    position: fixed;
    left: 0;
    top: 0;
    will-change: transform;
  }

  .lightbox-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
  }

  .lightbox-cap {
    color: rgba(255, 255, 255, 0.85);
    text-align: center;
    margin-top: 12px;
    font-size: 14px;
  }

  /* 悬浮：照片放大后轻轻上下浮动 */
  .lightbox-stage.float {
    animation: floatY 4.5s ease-in-out infinite;
  }

  @keyframes floatY {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  /* 便利贴：黄色贴纸，从照片右上角弹出来，比照片晚一点出现（毫秒级错开）。
     动画用 forwards 填充：播完保持显示，不会播完就消失。可拖动。 */
  .sticky-note {
    position: fixed;
    z-index: 4;
    max-width: 240px;
    padding: 14px 16px;
    background: #fff3b0;
    color: #5c4a00;
    font-size: 14px;
    line-height: 1.7;
    border-radius: 4px;
    box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.35);
    transform: rotate(-2deg);
    opacity: 0;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    pointer-events: auto;
  }

  .sticky-note::before {
    /* 便利贴顶部那一道撕胶带的感觉 */
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%) rotate(-2deg);
    width: 70px;
    height: 16px;
    background: rgba(255, 255, 255, 0.45);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
  }

  .lightbox.show .sticky-note {
    animation: noteIn 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) 0.18s forwards;
  }

  @keyframes noteIn {
    from {
      opacity: 0;
      transform: rotate(-6deg) scale(0.6) translateY(10px);
    }
    to {
      opacity: 1;
      transform: rotate(-2deg) scale(1) translateY(0);
    }
  }

  .lightbox-btn {
    position: fixed;
    z-index: 5;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .lightbox-btn:hover {
    background: rgba(255, 255, 255, 0.32);
  }

  .lightbox-close {
    top: 18px;
    right: 18px;
    font-size: 26px;
  }

  .lightbox-prev {
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
  }

  /* 窄屏 */
  @media (max-width: 640px) {
    .wall-title {
      font-size: 21px;
      top: 14px;
      left: 18px;
    }
    .sticky-note {
      max-width: 170px;
      font-size: 13px;
    }
  }
</style>

<script>
  const wall = document.getElementById('wall');
  const photos = Array.from(wall?.querySelectorAll('.photo') ?? []);

  // 背景涂鸦：随机散落 + 随机浮动（每次刷新/打开都重新随机分布）
  {
    const bg = document.getElementById('graffiti-bg');
    if (bg) {
      const items = Array.from(bg.querySelectorAll('.gz')) as HTMLElement[];
      items.forEach((el) => {
        const gsz = parseFloat(getComputedStyle(el).getPropertyValue('--gsz')) || 40;
        // 散落范围：全屏，边缘留一点余量避免被裁掉
        const x = Math.random() * Math.max(0, window.innerWidth - gsz - 40) + 20;
        const y = Math.random() * Math.max(0, window.innerHeight - gsz - 100) + 20; // 底部避开访客条
        el.style.setProperty('--gx', x.toFixed(0) + 'px');
        el.style.setProperty('--gy', y.toFixed(0) + 'px');
        // 每个元素自己的浮动参数：幅度、周期、延迟、旋转、缩放都随机
        el.style.setProperty('--gdx', ((Math.random() - 0.5) * 46).toFixed(0) + 'px');
        el.style.setProperty('--gdy', ((Math.random() - 0.5) * 40).toFixed(0) + 'px');
        el.style.setProperty('--grot', ((Math.random() - 0.5) * 50).toFixed(0) + 'deg');
        el.style.setProperty('--gspin', ((Math.random() - 0.5) * 22).toFixed(0) + 'deg');
        el.style.setProperty('--gscale', (1 + Math.random() * 0.18).toFixed(2));
        el.style.setProperty('--gdur', (4 + Math.random() * 5).toFixed(1) + 's');
        el.style.setProperty('--gdelay', (-Math.random() * 6).toFixed(1) + 's'); // 负延迟：一进来各自已在浮动中
        el.style.setProperty('--go', (0.3 + Math.random() * 0.35).toFixed(2));
      });
    }
  }

  if (photos.length) {
    // 固定种子的伪随机：每次刷新位置基本一致，不会乱跳
    function mulberry32(seed: number) {
      return function () {
        seed |= 0;
        seed = (seed + 0x6d2b79f5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    const rand = mulberry32(20261017);

    // 1) 散开摆放：随机位置 + 随机角度（宽度已由 CSS 按长宽比分好）
    const w = wall.clientWidth;
    const h = wall.clientHeight;
    photos.forEach((el) => {
      const pw = el.offsetWidth;
      const ph = el.offsetHeight;
      const x = rand() * Math.max(0, w - pw);
      // 顶部留给标题，不把照片撒在标题上
      const y = 64 + rand() * Math.max(0, h - 64 - ph);
      const rot = (rand() - 0.5) * 24;
      el.style.setProperty('--x', x.toFixed(1) + 'px');
      el.style.setProperty('--y', y.toFixed(1) + 'px');
      el.style.setProperty('--rot', rot.toFixed(1) + 'deg');
      el.classList.add('in');
    });

    // 2) 拖拽 + 放下弹跳 + 点击放大
    let zTop = 10;
    const bringToFront = (el: HTMLElement) => {
      zTop += 1;
      el.style.zIndex = String(zTop);
    };

    const getX = (el: HTMLElement) => parseFloat(el.style.getPropertyValue('--x')) || 0;
    const getY = (el: HTMLElement) => parseFloat(el.style.getPropertyValue('--y')) || 0;
    const clampV = (v: number, lo: number, hi: number) => Math.min(Math.max(v, lo), hi);

    // 放下时的小弹跳：用 rAF 直接驱动 transform，避免 CSS 动画/过渡造成闪现
    const settle = (el: HTMLElement, fx: number, fy: number) => {
      const rot = parseFloat(el.style.getPropertyValue('--rot')) || 0;
      const start = performance.now();
      const dur = 420;
      const easeOutBack = (t: number) => {
        const c1 = 1.70158;
        const c3 = c1 + 1;
        return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
      };
      const frame = (now: number) => {
        const p = Math.min(1, (now - start) / dur);
        // 先轻轻弹起一点，再落回原位（自然物体落地的偏移感）
        const oy = -16 * easeOutBack(p);
        const s = 1 + 0.02 * Math.sin(p * Math.PI);
        const rw = 3 * Math.sin(p * Math.PI * 2) * (1 - p);
        el.style.transform = `translate(${fx}px, ${fy + oy}px) rotate(${rot + rw}deg) scale(${s})`;
        if (p < 1) {
          requestAnimationFrame(frame);
        } else {
          el.style.setProperty('--x', fx.toFixed(1) + 'px');
          el.style.setProperty('--y', fy.toFixed(1) + 'px');
          el.style.transform = '';
        }
      };
      requestAnimationFrame(frame);
    };

    photos.forEach((el: HTMLElement) => {
      let dragging = false;
      let moved = false;
      let startX = 0,
        startY = 0,
        baseX = 0,
        baseY = 0;

      el.addEventListener('pointerdown', (e) => {
        dragging = true;
        moved = false;
        startX = e.clientX;
        startY = e.clientY;
        baseX = getX(el);
        baseY = getY(el);
        el.setPointerCapture(e.pointerId);
        el.classList.add('dragging');
        bringToFront(el);
      });

      el.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        if (Math.abs(dx) + Math.abs(dy) > 4) moved = true;
        if (moved) {
          el.style.transform = `translate(${baseX + dx}px, ${baseY + dy}px) rotate(${
            el.style.getPropertyValue('--rot') || '0deg'
          })`;
        }
      });

      const endDrag = (e: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        el.classList.remove('dragging');
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        if (moved) {
          // 边界限制：始终留至少 60px 在画布内，不会整个拖出去消失
          const pw = el.offsetWidth;
          const ph = el.offsetHeight;
          const ww = wall.clientWidth;
          const wh = wall.clientHeight;
          const nx = clampV(baseX + dx, -(pw - 60), ww - 60);
          const ny = clampV(baseY + dy, -(ph - 60), wh - 60);
          el.style.transform = `translate(${nx}px, ${ny}px) rotate(${
            el.style.getPropertyValue('--rot') || '0deg'
          })`;
          settle(el, nx, ny);
        } else {
          openLightbox(el);
        }
      };
      el.addEventListener('pointerup', endDrag);
      el.addEventListener('pointercancel', endDrag);
    });

    // 3) 大图查看：照片从墙上旋转飞到中间，关闭时扭动着飞回去
    const lightbox = document.getElementById('lightbox') as HTMLElement;
    const stage = document.getElementById('lightbox-stage') as HTMLElement;
    const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lbCap = document.getElementById('lightbox-cap') as HTMLElement;
    const lbNote = document.getElementById('lightbox-note') as HTMLElement;
    let current = -1;
    let animating = false; // 正在切换
    let closing = false; // 正在飞回墙上

    // 出名的缓动曲线（easing functions），全程用它们驱动动画
    // easeOutBack：先快后慢，末尾轻微过冲回稳（弹性）；easeInBack：末尾过冲（扭动感）
    const easeOutBack = (t: number) => {
      const c1 = 1.70158;
      const c3 = c1 + 1;
      return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
    };
    const easeInOutCubic = (t: number) =>
      t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    const easeInBack = (t: number) => {
      const c1 = 1.70158;
      const c3 = c1 + 1;
      return c3 * t * t * t - c1 * t * t;
    };

    // 按图片原始比例算展示尺寸（有上限，不会太大）
    const fitSize = (nw: number, nh: number) => {
      let dw = Math.min(nw, window.innerWidth * 0.9, 1200);
      let dh = (dw * nh) / nw;
      if (dh > window.innerHeight * 0.8) {
        dh = window.innerHeight * 0.8;
        dw = (dh * nw) / nh;
      }
      return { dw, dh };
    };

    const fill = (el: HTMLElement) => {
      lbImg.src = (el.querySelector('img') as HTMLImageElement).src;
      lbCap.textContent = el.dataset.name || '';
      lbNote.textContent = el.dataset.note || '';
      lbNote.style.display = el.dataset.note ? '' : 'none';
    };

    // 便利贴贴在照片右上角外侧（按居中后的最终位置算，不依赖过渡中的动画位置）
    const placeNote = () => {
      const dw = stage.offsetWidth;
      const dh = stage.offsetHeight;
      const cx = window.innerWidth / 2;
      const cy = window.innerHeight / 2;
      const left = Math.min(cx + dw / 2 + 16, window.innerWidth - 260);
      lbNote.style.left = Math.max(16, left) + 'px';
      lbNote.style.top = Math.max(20, cy - dh / 2 - 8) + 'px';
    };

    const openLightbox = (el: HTMLElement) => {
      if (closing) return;
      current = photos.indexOf(el);
      const thumbImg = el.querySelector('img') as HTMLImageElement;
      const nw = thumbImg.naturalWidth || 1000;
      const nh = thumbImg.naturalHeight || 750;
      const { dw, dh } = fitSize(nw, nh);
      stage.style.width = dw + 'px';
      stage.style.height = dh + 'px';
      fill(el);

      const ccx = window.innerWidth / 2;
      const ccy = window.innerHeight / 2;
      stage.style.left = ccx - dw / 2 + 'px';
      stage.style.top = ccy - dh / 2 + 'px';

      // FLIP 起点：墙上的缩略图位置
      const tr = el.getBoundingClientRect();
      const tcx = tr.left + tr.width / 2;
      const tcy = tr.top + tr.height / 2;
      const rot = parseFloat(el.style.getPropertyValue('--rot')) || 0;
      const s = tr.width / dw;

      stage.classList.remove('float');
      stage.style.transition = 'none';
      stage.style.opacity = '0';
      stage.style.transform = `translate(${tcx - ccx}px, ${tcy - ccy}px) rotate(${rot}deg) scale(${s})`;
      lightbox.classList.add('show');
      lightbox.setAttribute('aria-hidden', 'false');
      wall.classList.add('blurred');
      document.body.style.overflow = 'hidden';
      placeNote();

      // 用 easeOutBack 从缩略图飞到中间：先快后慢，稍微过冲再回稳
      const start = performance.now();
      const dur = 560;
      const flyIn = (now: number) => {
        const t = Math.min(1, (now - start) / dur);
        const k = easeOutBack(t);
        const tx = (tcx - ccx) * (1 - k);
        const ty = (tcy - ccy) * (1 - k);
        const r = rot * (1 - k);
        const sc = s + (1 - s) * k;
        stage.style.transform = `translate(${tx}px, ${ty}px) rotate(${r}deg) scale(${sc})`;
        stage.style.opacity = t < 0.35 ? String(t / 0.35) : '1';
        if (t < 1) {
          requestAnimationFrame(flyIn);
        } else {
          stage.style.transform = 'translate(0, 0) rotate(0deg) scale(1)';
          stage.style.transition = 'none';
          stage.classList.add('float');
        }
      };
      requestAnimationFrame(flyIn);
    };

    const closeLightbox = () => {
      if (!lightbox.classList.contains('show') || animating || closing) return;
      if (current < 0) return;
      const el = photos[current];
      closing = true;
      stage.classList.remove('float');
      stage.style.transition = 'none';
      stage.style.transform = 'translate(0, 0) rotate(0deg) scale(1)';

      const tr = el.getBoundingClientRect();
      const tcx = tr.left + tr.width / 2;
      const tcy = tr.top + tr.height / 2;
      const ccx = window.innerWidth / 2;
      const ccy = window.innerHeight / 2;
      const rot = parseFloat(el.style.getPropertyValue('--rot')) || 0;
      const s = tr.width / stage.offsetWidth;

      // 飞回去：位置用 easeInOutCubic 平滑拉回，角度用 easeInBack 产生扭动过冲
      const start = performance.now();
      const dur = 560;
      const flyBack = (now: number) => {
        const t = Math.min(1, (now - start) / dur);
        const kp = easeInOutCubic(t);
        const kr = easeInBack(t);
        const tx = (tcx - ccx) * kp;
        const ty = (tcy - ccy) * kp;
        const r = rot * kr;
        const sc = 1 + (s - 1) * kp;
        stage.style.transform = `translate(${tx}px, ${ty}px) rotate(${r}deg) scale(${sc})`;
        stage.style.opacity = t < 0.55 ? '1' : String(Math.max(0, 1 - (t - 0.55) / 0.45));
        if (t < 1) {
          requestAnimationFrame(flyBack);
        } else {
          closing = false;
          wall.classList.remove('blurred');
          lightbox.classList.remove('show');
          lightbox.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
      };
      requestAnimationFrame(flyBack);
    };

    // 左右切换：快速淡出淡入（JS 驱动，避免和 CSS 过渡状态打架）
    const step = (d: number) => {
      if (animating || closing) return;
      current = (current + d + photos.length) % photos.length;
      const el = photos[current];
      const thumbImg = el.querySelector('img') as HTMLImageElement;
      const nw = thumbImg.naturalWidth || stage.offsetWidth;
      const nh = thumbImg.naturalHeight || stage.offsetHeight;
      const { dw, dh } = fitSize(nw, nh);
      animating = true;
      const fadeDur = 180;
      const fadeOutStart = performance.now();
      const fadeOut = (now: number) => {
        const t = Math.min(1, (now - fadeOutStart) / fadeDur);
        stage.style.opacity = String(1 - t);
        if (t < 1) {
          requestAnimationFrame(fadeOut);
        } else {
          stage.style.width = dw + 'px';
          stage.style.height = dh + 'px';
          stage.style.left = window.innerWidth / 2 - dw / 2 + 'px';
          stage.style.top = window.innerHeight / 2 - dh / 2 + 'px';
          fill(el);
          placeNote();
          stage.style.opacity = '0';
          const fadeInStart = performance.now();
          const fadeIn = (now2: number) => {
            const t2 = Math.min(1, (now2 - fadeInStart) / fadeDur);
            stage.style.opacity = String(t2);
            if (t2 < 1) {
              requestAnimationFrame(fadeIn);
            } else {
              animating = false;
            }
          };
          requestAnimationFrame(fadeIn);
        }
      };
      requestAnimationFrame(fadeOut);
    };

    // 便利贴：可以自由拖动；点击/拖动便利贴都不会关闭大图
    {
      let noteDrag = false;
      let noteDX = 0,
        noteDY = 0;
      lbNote.addEventListener('pointerdown', (e) => {
        noteDrag = true;
        e.preventDefault();
        lbNote.setPointerCapture(e.pointerId);
        noteDX = e.clientX - lbNote.offsetLeft;
        noteDY = e.clientY - lbNote.offsetTop;
      });
      lbNote.addEventListener('pointermove', (e) => {
        if (!noteDrag) return;
        lbNote.style.left = e.clientX - noteDX + 'px';
        lbNote.style.top = e.clientY - noteDY + 'px';
      });
      const endNote = () => {
        noteDrag = false;
      };
      lbNote.addEventListener('pointerup', endNote);
      lbNote.addEventListener('pointercancel', endNote);
    }

    lightbox.querySelectorAll('[data-close]').forEach((btn) =>
      btn.addEventListener('click', closeLightbox)
    );
    lightbox.querySelector('[data-prev]')?.addEventListener('click', () => step(-1));
    lightbox.querySelector('[data-next]')?.addEventListener('click', () => step(1));
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('show')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
    window.addEventListener('resize', () => {
      if (lightbox.classList.contains('show')) placeNote();
    });
  }
</script>
