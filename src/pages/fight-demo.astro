---
import Base from '../layouts/Base.astro';
---

<Base title="招式演示" description="小人打架的全部招式逐个演示">
  <div class="container demo-page">
    <header class="page-head">
      <h1>招式演示</h1>
      <p>逐个播放并标注名称，方便一招一招检查。</p>
    </header>

    <section class="demo-stage">
      <canvas id="demo-canvas"></canvas>
    </section>

    <div class="demo-controls">
      <label class="who-label">角色
        <select id="demo-who"></select>
      </label>
      <button id="demo-prev" type="button">← 上一个</button>
      <button id="demo-next" type="button">下一个 →</button>
      <button id="demo-pause" type="button">⏸ 暂停</button>
      <button id="demo-slow" type="button">🐢 慢放</button>
      <button id="demo-auto" type="button">🔁 自动轮播：关</button>
      <button id="demo-geo" type="button">🎯 判定盒：关</button>
      <span class="demo-keys">快捷键：← → 切换 · 空格 暂停 · S 慢放 · A 轮播 · G 判定盒</span>
    </div>

    <ol class="demo-list" id="demo-list"></ol>
  </div>

  <style is:global>
    .demo-page {
      padding-bottom: 60px;
    }
    .demo-stage {
      margin: 24px 0 16px;
      height: 240px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: linear-gradient(180deg, transparent 0%, var(--bg-elevated) 84%);
      overflow: hidden;
    }
    .demo-stage canvas {
      display: block;
      width: 100%;
      height: 100%;
    }
    .demo-controls {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }
    .demo-controls button {
      padding: 6px 14px;
      font-size: 13px;
      font-family: inherit;
      color: var(--text);
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 8px;
      cursor: pointer;
      transition: border-color 0.15s ease, color 0.15s ease;
    }
    .demo-controls button:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .demo-controls button.on {
      border-color: var(--accent);
      color: var(--accent);
    }
    .demo-keys {
      font-family: var(--font-mono);
      font-size: 11.5px;
      color: var(--text-faint);
      margin-left: 4px;
    }
    .who-label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: var(--text-muted);
    }
    .who-label select {
      padding: 6px 10px;
      font-size: 13px;
      font-family: inherit;
      color: var(--text);
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    .demo-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 6px;
      margin: 20px 0 0;
      padding: 0;
      list-style: none;
    }
    .demo-list li button {
      width: 100%;
      text-align: left;
      padding: 7px 11px;
      font-family: inherit;
      font-size: 12.5px;
      color: var(--text-muted);
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .demo-list li button:hover {
      color: var(--text);
      border-color: var(--text-faint);
    }
    .demo-list li button.cur {
      color: var(--bg);
      background: var(--accent);
      border-color: var(--accent);
    }
    @media (max-width: 640px) {
      .demo-stage {
        height: 200px;
      }
    }
  </style>

  <script>
    import { initFightBand } from '../scripts/fight';

    // ?auto=1 切换为 AI 自动对战模式（默认是逐招演示模式）
    // forceVisible：无头浏览器里 IntersectionObserver 判定不稳定，调试页直接绕过可见性门控
    // ?l=&r= 指定左右角色（ROSTER 下标），用于固定对阵做大规模检测
    const qs0 = new URLSearchParams(location.search);
    const l0 = Number(qs0.get('l'));
    const r0 = Number(qs0.get('r'));
    const matchup0 = qs0.has('l') && qs0.has('r') && !Number.isNaN(l0) && !Number.isNaN(r0) ? { left: l0, right: r0 } : undefined;
    const manual0 = qs0.has('manual');
    initFightBand({ canvasId: 'demo-canvas', demo: !qs0.has('auto') && !manual0, forceVisible: true, matchup: matchup0, manual: manual0 });

    const api = () => (window as any).takinolFight?.demo;

    // URL 参数：?move=hook&frac=0.55 —— 直接定格到某招某帧，方便逐帧检查 / 截图
    const qs = new URLSearchParams(location.search);
    const mv = qs.get('move');
    const frac = Number(qs.get('frac'));
    if (mv) {
      const d0 = api();
      const item = d0?.list.find((x) => x.key === mv);
      if (d0 && item) {
        d0.go(item.i);
        if (qs.has('frac') && !Number.isNaN(frac)) d0.seek(frac);
      }
    }

    const listEl = document.getElementById('demo-list');
    const pauseBtn = document.getElementById('demo-pause') as HTMLButtonElement | null;
    const slowBtn = document.getElementById('demo-slow') as HTMLButtonElement | null;
    const autoBtn = document.getElementById('demo-auto') as HTMLButtonElement | null;
    const geoBtn = document.getElementById('demo-geo') as HTMLButtonElement | null;

    // 角色切换：同步 15 人 roster，切换后用当前招式重新演示
    const whoSel = document.getElementById('demo-who') as HTMLSelectElement | null;
    const roster = (window as any).takinolFight?.demo?.roster?.() ?? [];
    if (whoSel && roster.length) {
      for (const r of roster) {
        const o = document.createElement('option');
        o.value = String(r.i);
        o.textContent = `${r.i + 1}. ${r.name}`;
        whoSel.appendChild(o);
      }
      whoSel.addEventListener('change', () => {
        api()?.who(Number(whoSel.value));
        sync();
      });
    }

    const items: { i: number; key: string; name: string }[] = api()?.list ?? [];

    // 生成招式目录（点一下直接跳到那一招）
    if (listEl) {
      for (const it of items) {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = it.name;
        btn.dataset.idx = String(it.i);
        btn.addEventListener('click', () => api()?.go(it.i));
        li.appendChild(btn);
        listEl.appendChild(li);
      }
    }

    // 高亮当前项 + 同步按钮状态
    const sync = () => {
      const d = api();
      if (!d) return;
      const cur = d.idx;
      listEl?.querySelectorAll('button').forEach((b) => {
        b.classList.toggle('cur', Number((b as HTMLElement).dataset.idx) === cur);
      });
      if (pauseBtn) {
        pauseBtn.textContent = d.paused ? '▶ 继续' : '⏸ 暂停';
        pauseBtn.classList.toggle('on', !!d.paused);
      }
      if (slowBtn) {
        slowBtn.textContent = d.slowOn ? '🐇 恢复速度' : '🐢 慢放';
        slowBtn.classList.toggle('on', !!d.slowOn);
      }
      if (autoBtn) {
        autoBtn.textContent = d.autoOn ? '🔁 自动轮播：开' : '🔁 自动轮播：关';
        autoBtn.classList.toggle('on', !!d.autoOn);
      }
      if (geoBtn) {
        const on = !!d.geoOn;
        geoBtn.textContent = on ? '🎯 判定盒：开' : '🎯 判定盒：关';
        geoBtn.classList.toggle('on', on);
      }
    };
    setInterval(sync, 120);
    sync();

    document.getElementById('demo-prev')?.addEventListener('click', () => {
      const d = api();
      if (d) d.go(d.idx - 1);
    });
    document.getElementById('demo-next')?.addEventListener('click', () => {
      const d = api();
      if (d) d.go(d.idx + 1);
    });
    pauseBtn?.addEventListener('click', () => {
      api()?.pause();
      sync();
    });
    slowBtn?.addEventListener('click', () => {
      api()?.slow();
      sync();
    });
    // 自动轮播开关：关 = 只循环当前这一招（点招式后的默认状态）
    autoBtn?.addEventListener('click', () => {
      api()?.auto();
      sync();
    });
    // 判定盒（红胶囊/绿受击框）开关：等价于 URL 上加 ?debug=frames
    geoBtn?.addEventListener('click', () => {
      api()?.toggleGeo();
      sync();
    });
    window.addEventListener('keydown', (ev) => {
      if (ev.key === 'a' || ev.key === 'A') {
        api()?.auto();
        sync();
      } else if (ev.key === 'g' || ev.key === 'G') {
        api()?.toggleGeo();
        sync();
      }
    });
  </script>
</Base>
