---
/**
 * 招式逐帧检查页（调试用）
 * URL：/pose?move=hook&frac=0.6&fx=1
 *   move = 招式 key（jab/cross/hook/.../spinKick/flyKick/scissorKick/hurtLight/...）
 *   frac = 0~1 的进度，定格在那一帧
 *   fx   = 1 时在定格画面上触发一次该招的命中特效（并冻结，供检查特效）
 * 无页头、无目录，只有画布 —— 方便直接截图对比。
 */
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>pose · 逐帧检查</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        background: #f6f4ef;
        overflow: hidden;
      }
      #pose-canvas {
        display: block;
        width: 100vw;
        height: 100vh;
      }
      /* 独立打开（非图鉴 iframe）时给一条回到工具的出口，避免变成死胡同 */
      #pose-back {
        position: fixed;
        left: 12px;
        bottom: 12px;
        z-index: 9;
        display: none;
        gap: 6px;
        align-items: center;
        padding: 6px 12px;
        border-radius: 999px;
        border: 1px solid rgba(0, 0, 0, 0.12);
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(6px);
        color: #1c1c20;
        font: 13px/1.4 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        text-decoration: none;
      }
      #pose-back:hover {
        border-color: #1a5fb4;
        color: #1a5fb4;
      }
    </style>
  </head>
  <body>
    <canvas id="pose-canvas"></canvas>
    <a id="pose-back" href="/fight-demo">← 招式演示</a>
    <script>
      import { initFightBand } from '../scripts/fight';

      // 只在「独立打开」时显示返回入口；被 /roster 的 iframe 嵌入时保持纯画布
      if (window.self === window.top) {
        const back = document.getElementById('pose-back') as HTMLElement | null;
        if (back) back.style.display = 'inline-flex';
      }

      const qs = new URLSearchParams(location.search);
      // noHud=1：隐藏 canvas 顶部的招式标题条（角色图鉴等嵌入场景用）
      initFightBand({ canvasId: 'pose-canvas', demo: true, forceVisible: true, hud: !qs.has('noHud') });

      const api = () => (window as any).takinolFight?.demo;
      const mv = qs.get('move');
      const frac = Number(qs.get('frac'));
      // who = ROSTER 索引，切换演示位角色（检查各流派剪影 / 动态件）
      const who = Number(qs.get('who'));
      // 把角色名写进标题，父页面（角色图鉴）可以直接读，无需硬编码名单
      if (qs.has('who') && !Number.isNaN(who)) {
        const nm = api()?.who(who);
        if (nm) document.title = `${nm} · pose`;
      }
      if (mv) {
        const d = api();
        const item = d?.list.find((x) => x.key === mv);
        if (d && item) {
          d.go(item.i);
          d.seek(qs.has('frac') && !Number.isNaN(frac) ? frac : 0.5);
          // ?fx=1 定格触发命中特效（特效与画面一起被冻结，方便逐招检查特效）
          if (qs.has('fx')) d.fx();
        }
      }
    </script>
  </body>
</html>
