---
import Base from '../layouts/Base.astro';
---

<Base title="竞技场" description="设定模式：选角色、调参数对打">
  <div class="container arena-page">
    <header class="page-head">
      <h1>竞技场</h1>
      <p>选角色、调参数，逐招微调。普通击倒会起身；主页仅在实际阵亡后换人。</p>
    </header>

    <section class="arena-controls">
      <!-- 角色选择（由引擎 ROSTER 动态填充，新增角色自动出现） -->
      <div class="row">
        <label>
          左侧
          <select id="left-pick">
            <option value="0" selected>载入中…</option>
          </select>
        </label>
        <span class="vs">VS</span>
        <label>
          右侧
          <select id="right-pick">
            <option value="1">载入中…</option>
          </select>
        </label>
        <span class="arena-divider"></span>
        <button id="start" type="button">▶ 开始</button>
        <button id="reset" type="button" class="btn-ghost">↺ 重置</button>
      </div>

      <!-- 参数滑块 -->
      <div class="row sliders">
        <label>侵略性 <span id="agg-val">0.8</span>
          <input id="agg" type="range" min="0.2" max="1.5" step="0.05" value="0.8" />
        </label>
        <label>格挡倾向 <span id="guard-val">0.45</span>
          <input id="guard" type="range" min="0.1" max="0.9" step="0.05" value="0.45" />
        </label>
        <label>血量 <span id="hp-val">100</span>
          <input id="hp" type="range" min="50" max="500" step="10" value="100" />
        </label>
        <label>速度 <span id="speed-val">1.0</span>
          <input id="speed" type="range" min="0.5" max="2.0" step="0.1" value="1.0" />
        </label>
      </div>

      <!-- 实时状态显示 -->
      <div class="arena-status" id="arena-status">
        <div class="status-fighter" id="status-left">
          <span class="status-name">—</span>
          <span class="status-hp">HP: —/—</span>
          <span class="state-badge" id="state-left">—</span>
        </div>
        <div class="status-vs">⚔</div>
        <div class="status-fighter" id="status-right">
          <span class="status-name">—</span>
          <span class="status-hp">HP: —/—</span>
          <span class="state-badge" id="state-right">—</span>
        </div>
      </div>
    </section>

    <section class="arena-stage">
      <canvas id="arena-canvas"></canvas>
    </section>

    <!-- 调试工具栏（可选展开） -->
    <details class="arena-debug">
      <summary>调试工具</summary>
      <div class="debug-tools">
        <label><input type="checkbox" id="dbg-bones" /> 骨骼</label>
        <label><input type="checkbox" id="dbg-hitboxes" /> 命中盒</label>
        <label><input type="checkbox" id="dbg-frames" /> 帧数据</label>
        <label><input type="checkbox" id="dbg-hud" /> SF6 HUD</label>
        <a id="demo-link" href="/fight-demo" target="_blank" class="debug-link">→ 打开招式演示页</a>
      </div>
    </details>
  </div>

  <style is:global>
    .arena-page {
      padding-bottom: 60px;
    }
    .arena-controls {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin: 20px 0;
      padding: 16px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--bg-elevated);
    }
    .arena-controls .row {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }
    .arena-divider {
      width: 1px;
      height: 24px;
      background: var(--border);
      margin: 0 4px;
    }
    .arena-controls select {
      padding: 6px 10px;
      font-size: 14px;
      font-family: inherit;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    .arena-controls .vs {
      font-weight: 700;
      color: var(--accent);
      font-size: 15px;
    }
    .arena-controls .sliders label {
      flex: 1;
      min-width: 140px;
      font-size: 13px;
      color: var(--text-muted);
    }
    .arena-controls input[type='range'] {
      width: 100%;
      margin-top: 4px;
    }
    .arena-controls button {
      padding: 8px 18px;
      font-size: 14px;
      font-family: inherit;
      color: var(--bg);
      background: var(--accent);
      border: none;
      border-radius: 8px;
      cursor: pointer;
      white-space: nowrap;
    }
    .arena-controls button:hover {
      opacity: 0.88;
    }
    .arena-controls button.btn-ghost {
      color: var(--text);
      background: transparent;
      border: 1px solid var(--border);
    }
    .arena-controls button.btn-ghost:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    /* 实时状态条 */
    .arena-status {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      padding: 10px 14px;
      background: var(--bg);
      border-radius: 8px;
      font-size: 13px;
      font-family: var(--font-mono, ui-monospace, monospace);
    }
    .status-fighter {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 180px;
    }
    .status-name {
      font-weight: 600;
      color: var(--text);
      min-width: 60px;
    }
    .status-hp {
      color: var(--text-muted);
    }
    .state-badge {
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 4px;
      background: var(--bg-elevated);
      color: var(--text-muted);
      border: 1px solid var(--border);
    }
    .state-badge.state-combat {
      color: #e17055;
      border-color: #e1705544;
      background: #e1705511;
    }
    .state-badge.state-hurt {
      color: #e74c3c;
      border-color: #e74c3c44;
      background: #e74c3c11;
    }
    .state-badge.state-move {
      color: #3498db;
      border-color: #3498db44;
      background: #3498db11;
    }
    .status-vs {
      color: var(--text-faint);
      font-size: 16px;
    }

    /* 舞台 */
    .arena-stage {
      height: 380px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: linear-gradient(180deg, transparent 0%, var(--bg-elevated) 84%);
      overflow: hidden;
    }
    .arena-stage canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    /* 调试面板 */
    .arena-debug {
      margin-top: 16px;
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
    }
    .arena-debug summary {
      padding: 8px 12px;
      font-size: 13px;
      color: var(--text-muted);
      cursor: pointer;
      user-select: none;
    }
    .arena-debug summary:hover {
      color: var(--text);
    }
    .debug-tools {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 10px 14px;
      border-top: 1px solid var(--border);
      flex-wrap: wrap;
    }
    .debug-tools label {
      font-size: 13px;
      color: var(--text-muted);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .debug-tools label input[type='checkbox'] {
      accent-color: var(--accent);
    }
    .debug-link {
      font-size: 13px;
      color: var(--accent);
      text-decoration: none;
      margin-left: auto;
    }
    .debug-link:hover {
      text-decoration: underline;
    }

    @media (max-width: 640px) {
      .arena-stage {
        height: 280px;
      }
      .arena-status {
        flex-direction: column;
        gap: 6px;
      }
      .status-vs {
        display: none;
      }
      .sliders label {
        min-width: 120px !important;
      }
    }
  </style>

  <script>
    import { initFightBand } from '../scripts/fight';

    const leftEl = document.getElementById('left-pick') as HTMLSelectElement;
    const rightEl = document.getElementById('right-pick') as HTMLSelectElement;
    const aggEl = document.getElementById('agg') as HTMLInputElement;
    const guardEl = document.getElementById('guard') as HTMLInputElement;
    const hpEl = document.getElementById('hp') as HTMLInputElement;
    const speedEl = document.getElementById('speed') as HTMLInputElement;

    // 同步滑块数值显示
    const sync = () => {
      (document.getElementById('agg-val') as HTMLElement).textContent = aggEl.value;
      (document.getElementById('guard-val') as HTMLElement).textContent = guardEl.value;
      (document.getElementById('hp-val') as HTMLElement).textContent = hpEl.value;
      (document.getElementById('speed-val') as HTMLElement).textContent = speedEl.value;
    };
    for (const el of [aggEl, guardEl, hpEl, speedEl]) el.addEventListener('input', sync);
    sync();

    let statusTimer = 0;

    const start = () => {
      (window as any).takinolFight?.destroy?.();
      if (statusTimer) { clearInterval(statusTimer); statusTimer = 0; }

      const old = document.getElementById('arena-canvas');
      const parent = old?.parentElement;
      const canvas = document.createElement('canvas');
      canvas.id = 'arena-canvas';
      parent?.appendChild(canvas);
      old?.remove();

      initFightBand({
        canvasId: 'arena-canvas',
        endless: false,
        forceVisible: true,
        matchup: { left: Number(leftEl.value), right: Number(rightEl.value) },
        params: {
          aggression: Number(aggEl.value),
          guardChance: Number(guardEl.value),
          hp: Number(hpEl.value),
        },
        debugOptions: {
          bones: (document.getElementById('dbg-bones') as HTMLInputElement)?.checked,
          hitboxes: (document.getElementById('dbg-hitboxes') as HTMLInputElement)?.checked,
          frames: (document.getElementById('dbg-frames') as HTMLInputElement)?.checked,
          hud: (document.getElementById('dbg-hud') as HTMLInputElement)?.checked,
        },
      });

      // 启动状态轮询
      const snapEl = document.getElementById('status-left');
      const snapElR = document.getElementById('status-right');
      const stateEl = document.getElementById('state-left');
      const stateElR = document.getElementById('state-right');
      statusTimer = window.setInterval(() => {
        const api = (window as any).takinolFight;
        if (!api?.snapshot) return;
        const s = api.snapshot();
        if (!s || !s.length) return;
        const a = s[0], b = s[1];
        if (snapEl) { snapEl.textContent = api.matchup?.()?.[0]?.name || `P${leftEl.value + 1}`; }
        if (snapElR) { snapElR.textContent = api.matchup?.()?.[1]?.name || `P${rightEl.value + 1}`; }

        const hpL = document.querySelector('#status-left .status-hp') as HTMLElement;
        const hpR = document.querySelector('#status-right .status-hp') as HTMLElement;
        if (hpL) hpL.textContent = `HP: ${a.hp}/${a.maxHp}`;
        if (hpR) hpR.textContent = `HP: ${b.hp}/${b.maxHp}`;

        if (stateEl) {
          stateEl.textContent = a.state;
          stateEl.className = 'state-badge' + (
            ['jab','cross','hook','uppercut','elbow','knee','throw','snapKick','pushKick','sideKick','roundKick','axeKick','spinKick','flyKick','scissorKick','thrust','smash','bash','slash','palm','swing','iai','flailSwing','gearPunch','bolt','shuriken','counterStrike'].includes(a.state)
              ? ' state-combat'
              : ['hurtLight','hurtHeavy','hurtUp','hurtLeg','stumble','down'].includes(a.state)
                ? ' state-hurt'
                : ['idle','walk','approach','retreat','jump'].includes(a.state)
                  ? ' state-move'
                  : ''
          );
        }
        if (stateElR) {
          stateElR.textContent = b.state;
          stateElR.className = 'state-badge' + (
            ['jab','cross','hook','uppercut','elbow','knee','throw','snapKick','pushKick','sideKick','roundKick','axeKick','spinKick','flyKick','scissorKick','thrust','smash','bash','slash','palm','swing','iai','flailSwing','gearPunch','bolt','shuriken','counterStrike'].includes(b.state)
              ? ' state-combat'
              : ['hurtLight','hurtHeavy','hurtUp','hurtLeg','stumble','down'].includes(b.state)
                ? ' state-hurt'
                : ['idle','walk','approach','retreat','jump'].includes(b.state)
                  ? ' state-move'
                  : ''
          );
        }
      }, 150);
    };

    // 重置：恢复默认参数并重新开始
    const reset = () => {
      aggEl.value = '0.8';
      guardEl.value = '0.45';
      hpEl.value = '100';
      speedEl.value = '1.0';
      leftEl.selectedIndex = 0;
      rightEl.selectedIndex = 1;
      sync();
      start();
    };

    // 角色名单从引擎读（ROSTER 有几个人就有几个选项，新增角色自动出现）
    const fillPicks = () => {
      const list = (window as any).takinolFight?.demo?.roster?.() ?? [];
      if (!list.length) return;
      const mk = (el: HTMLSelectElement, pick: number) => {
        const keep = el.value;
        el.innerHTML = '';
        for (const r of list) {
          const o = document.createElement('option');
          o.value = String(r.i);
          o.textContent = `${r.i + 1}. ${r.name}`;
          el.appendChild(o);
        }
        el.value = keep;
        if (!el.value) el.value = String(pick);
      };
      mk(leftEl, 0);
      mk(rightEl, Math.min(1, list.length - 1));

      // URL 参数：/arena?l=9&r=11 直接指定左右角色
      const q2 = new URLSearchParams(location.search);
      const l = Number(q2.get('l'));
      const r = Number(q2.get('r'));
      if (!Number.isNaN(l) && q2.has('l')) leftEl.value = String(Math.max(0, Math.min(list.length - 1, l)));
      if (!Number.isNaN(r) && q2.has('r')) rightEl.value = String(Math.max(0, Math.min(list.length - 1, r)));
    };

    document.getElementById('start')?.addEventListener('click', start);
    document.getElementById('reset')?.addEventListener('click', reset);

    // 调试复选框：现在实时生效（引擎每帧读 debugOptions，不需要重启对局）
    const dbgApi = () => (window as any).takinolFight?.demo;
    const applyDbg = () => {
      dbgApi()?.debug?.({
        bones: (document.getElementById('dbg-bones') as HTMLInputElement)?.checked,
        hitboxes: (document.getElementById('dbg-hitboxes') as HTMLInputElement)?.checked,
        frames: (document.getElementById('dbg-frames') as HTMLInputElement)?.checked,
        hud: (document.getElementById('dbg-hud') as HTMLInputElement)?.checked,
      });
    };
    for (const id of ['dbg-bones', 'dbg-hitboxes', 'dbg-frames', 'dbg-hud']) {
      document.getElementById(id)?.addEventListener('change', applyDbg);
    }

    start();      // 先初始化一次，让引擎暴露 roster 接口
    fillPicks();  // 用 roster + URL 参数填入选项并选中最终角色
    start();      // 用最终选择重开，保证界面与实际对打同步
  </script>
</Base>
