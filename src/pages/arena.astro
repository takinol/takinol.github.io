---
import Base from '../layouts/Base.astro';
---

<Base title="竞技场" description="设定模式：选角色、调参数对打">
  <div class="container arena-page">
    <header class="page-head">
      <h1>竞技场</h1>
      <p>设定模式：选左右角色、调参数，看他们单挑。主页是无限模式（倒地换人）。</p>
    </header>

    <section class="arena-controls">
      <div class="row">
        <label>
          左侧
          <select id="left-pick">
            <option value="0">疾风剑客</option>
            <option value="1">林影游侠</option>
            <option value="2">赤焰武人</option>
            <option value="3">夜刃刺客</option>
            <option value="4">飞花剑姬</option>
          </select>
        </label>
        <span class="vs">VS</span>
        <label>
          右侧
          <select id="right-pick">
            <option value="0">疾风剑客</option>
            <option value="1" selected>林影游侠</option>
            <option value="2">赤焰武人</option>
            <option value="3">夜刃刺客</option>
            <option value="4">飞花剑姬</option>
          </select>
        </label>
      </div>

      <div class="row sliders">
        <label>侵略性 <span id="agg-val">0.8</span>
          <input id="agg" type="range" min="0.2" max="1.5" step="0.05" value="0.8" />
        </label>
        <label>格挡倾向 <span id="guard-val">0.45</span>
          <input id="guard" type="range" min="0.1" max="0.9" step="0.05" value="0.45" />
        </label>
        <label>血量 <span id="hp-val">100</span>
          <input id="hp" type="range" min="50" max="200" step="10" value="100" />
        </label>
      </div>

      <button id="start" type="button">开始对打</button>
    </section>

    <section class="arena-stage">
      <canvas id="arena-canvas"></canvas>
    </section>
  </div>

  <style is:global>
    .arena-page {
      padding-bottom: 60px;
    }
    .arena-controls {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin: 20px 0;
      padding: 16px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--bg-elevated);
    }
    .arena-controls .row {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }
    .arena-controls select {
      padding: 6px 10px;
      font-size: 14px;
      font-family: inherit;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    .arena-controls .vs {
      font-weight: 700;
      color: var(--accent);
    }
    .arena-controls .sliders label {
      flex: 1;
      min-width: 150px;
      font-size: 13px;
      color: var(--text-muted);
    }
    .arena-controls input[type='range'] {
      width: 100%;
      margin-top: 4px;
    }
    .arena-controls button {
      padding: 8px 18px;
      font-size: 14px;
      font-family: inherit;
      color: var(--bg);
      background: var(--accent);
      border: none;
      border-radius: 8px;
      cursor: pointer;
      align-self: flex-start;
    }
    .arena-stage {
      height: 280px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: linear-gradient(180deg, transparent 0%, var(--bg-elevated) 84%);
      overflow: hidden;
    }
    .arena-stage canvas {
      display: block;
      width: 100%;
      height: 100%;
    }
    @media (max-width: 640px) {
      .arena-stage {
        height: 220px;
      }
    }
  </style>

  <script>
    import { initFightBand } from '../scripts/fight';

    const leftEl = document.getElementById('left-pick') as HTMLSelectElement;
    const rightEl = document.getElementById('right-pick') as HTMLSelectElement;
    const aggEl = document.getElementById('agg') as HTMLInputElement;
    const guardEl = document.getElementById('guard') as HTMLInputElement;
    const hpEl = document.getElementById('hp') as HTMLInputElement;

    const sync = () => {
      (document.getElementById('agg-val') as HTMLElement).textContent = aggEl.value;
      (document.getElementById('guard-val') as HTMLElement).textContent = guardEl.value;
      (document.getElementById('hp-val') as HTMLElement).textContent = hpEl.value;
    };
    for (const el of [aggEl, guardEl, hpEl]) el.addEventListener('input', sync);
    sync();

    const start = () => {
      (window as any).takinolFight?.destroy?.();
      const old = document.getElementById('arena-canvas');
      const parent = old?.parentElement;
      const canvas = document.createElement('canvas');
      canvas.id = 'arena-canvas';
      parent?.appendChild(canvas);
      old?.remove();

      initFightBand({
        canvasId: 'arena-canvas',
        endless: false,
        showNames: true,
        matchup: { left: Number(leftEl.value), right: Number(rightEl.value) },
        params: {
          aggression: Number(aggEl.value),
          guardChance: Number(guardEl.value),
          hp: Number(hpEl.value),
        },
      });
    };

    // 角色名单从引擎读（ROSTER 有几个人就有几个选项，新增角色自动出现）
    const fillPicks = () => {
      const list = (window as any).takinolFight?.demo?.roster?.() ?? [];
      if (!list.length) return;
      const mk = (el: HTMLSelectElement, pick: number) => {
        const keep = el.value;
        el.innerHTML = '';
        for (const r of list) {
          const o = document.createElement('option');
          o.value = String(r.i);
          o.textContent = `${r.i + 1}. ${r.name}`;
          el.appendChild(o);
        }
        el.value = keep;
        if (!el.value) el.value = String(pick);
      };
      mk(leftEl, 0);
      mk(rightEl, Math.min(1, list.length - 1));

      // URL 参数：/arena?l=9&r=11 直接指定左右角色（角色图鉴的卡片链接用这个）
      const q2 = new URLSearchParams(location.search);
      const l = Number(q2.get('l'));
      const r = Number(q2.get('r'));
      if (!Number.isNaN(l) && q2.has('l')) leftEl.value = String(Math.max(0, Math.min(list.length - 1, l)));
      if (!Number.isNaN(r) && q2.has('r')) rightEl.value = String(Math.max(0, Math.min(list.length - 1, r)));
    };

    document.getElementById('start')?.addEventListener('click', start);
    start();      // 先初始化一次，让引擎暴露 roster 接口
    fillPicks();  // 用 roster + URL 参数填入选项并选中最终角色
    start();      // 用最终选择重开，保证界面与实际对打同步
  </script>
</Base>
