---
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const dateFmt = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

// 按正文中文字符数估算阅读时长（约每分钟 400 字）
function minutesRead(post: any): number {
  const body: string = post.body ?? '';
  const chars = body.replace(/\s+/g, '').length;
  return Math.max(1, Math.round(chars / 400));
}

// 右侧标签集合：统计每个标签出现次数，按次数从多到少排
const tagCount = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags ?? []) {
    const key = String(t).trim();
    if (!key) continue;
    tagCount.set(key, (tagCount.get(key) ?? 0) + 1);
  }
}
const tagList = [...tagCount.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-Hans-CN')
);

// 蒙德里安（Piet Mondrian）色系：红 / 蓝 / 黄 / 白 + 黑色分割线
// fg 是该底色上用来看得清的文字颜色
const mondrian = [
  { bg: '#DD0100', fg: '#FFF6EF' }, // 蒙德里安红
  { bg: '#0B4EA2', fg: '#EAF2FF' }, // 蒙德里安蓝
  { bg: '#F5D000', fg: '#161616' }, // 蒙德里安黄
  { bg: '#F4F1EA', fg: '#161616' }, // 暖白
];

// 每个色块的“随意长度”：让矩形高低不一，拼起来更像蒙德里安的构成画
const mondrianHeights = [232, 168, 204, 148, 220, 180];

// 孟菲斯（Memphis Group，1981 米兰首展）层压板色卡 —— 取自 Carlton 置物架的馆藏记录
const memphis = [
  { bg: '#DE0C62', fg: '#FFF5EE' }, // Memphis Pink 粉
  { bg: '#2242C7', fg: '#FFF5EE' }, // Memphis Blue 钴蓝
  { bg: '#FFDF22', fg: '#070D0D' }, // Primrose Yellow 樱草黄
  { bg: '#9ACD32', fg: '#070D0D' }, // Carlton Lime 青柠
  { bg: '#95A3A6', fg: '#070D0D' }, // Laminate Grey 层压板灰
  { bg: '#FFF5EE', fg: '#070D0D' }, // Bacterio White 骨白
];

// 按标签名做稳定哈希取色：同一个标签永远同一个颜色，以后加标签也不用管配色
function hashTag(tag: string): number {
  let h = 5381;
  for (let i = 0; i < tag.length; i++) {
    h = ((h << 5) + h + tag.charCodeAt(i)) >>> 0;
  }
  return h;
}

// 先按哈希定位颜色，撞色就顺延到下一个空位 —— 保证标签之间颜色互不相同
const tagColorMap = new Map<string, { bg: string; fg: string }>();
{
  const used = new Set<number>();
  for (const [tag] of tagList) {
    let idx = hashTag(tag) % memphis.length;
    let step = 0;
    while (used.has(idx) && step < memphis.length) {
      idx = (idx + 1) % memphis.length;
      step++;
    }
    used.add(idx);
    tagColorMap.set(tag, memphis[idx]);
  }
}
---

<Base title="Blog" description="全部文章列表">
  <div class="container page-wrap">
    <article class="toc-content">
      <header class="page-head">
        <h1>Blog</h1>
        <p>全部文章，共 {posts.length} 篇。</p>
      </header>

      {
        posts.length > 0 ? (
          <div class="mondrian-grid" style="margin-top: 36px" id="post-list">
            {posts.map((post, i) => {
              const c = mondrian[i % mondrian.length];
              const h = mondrianHeights[i % mondrianHeights.length];
              return (
                <a
                  class="post-card"
                  href={`/blog/${post.id}/`}
                  data-tags={(post.data.tags ?? []).join(',')}
                  style={`--card-bg:${c.bg};--card-fg:${c.fg};--card-h:${h}px`}
                >
                  {post.data.cover && (
                    <span
                      class="pc-cover"
                      aria-hidden="true"
                      style={`background-image:url('${post.data.cover}');opacity:${post.data.coverOpacity}`}
                    />
                  )}
                  <div class="pc-meta">
                    <span>{dateFmt.format(post.data.date)}</span>
                    {post.data.updated && (
                      <>
                        <span class="pc-sep">/</span>
                        <span>更新 {dateFmt.format(post.data.updated)}</span>
                      </>
                    )}
                    <span class="pc-sep">·</span>
                    <span>{minutesRead(post)} 分钟</span>
                    <span class="pc-sep">·</span>
                    <span>{post.data.language}</span>
                  </div>
                  <div class="pc-title">{post.data.title}</div>
                  {post.data.description && <p class="pc-desc">{post.data.description}</p>}
                  {post.data.tags.length > 0 && (
                    <div class="pc-tags">
                      {post.data.tags.map((tag) => <span class="pc-tag">{tag}</span>)}
                    </div>
                  )}
                </a>
              );
            })}
          </div>
        ) : (
          <p style="margin-top: 40px; color: var(--text-muted)">还没有文章。</p>
        )
      }

      <p class="tag-empty" id="tag-empty" hidden>这个标签下还没有文章。</p>
    </article>

    <aside class={`toc-col${tagList.length > 0 ? ' has-tags' : ''}`}>
      {
        tagList.length > 0 && (
          <section class="tag-cloud" id="tag-cloud" aria-label="标签筛选">
            <div class="tag-cloud-title">标签</div>
            <div class="tag-cloud-list">
              <button type="button" class="tc-chip is-active" data-tag="" style="--tag-bg:#FFF5EE;--tag-fg:#070D0D">
                全部<span class="tc-count">{posts.length}</span>
              </button>
              {tagList.map(([tag, count]) => {
                const c = tagColorMap.get(tag) ?? memphis[0];
                return (
                  <button
                    type="button"
                    class="tc-chip"
                    data-tag={tag}
                    style={`--tag-bg:${c.bg};--tag-fg:${c.fg}`}
                  >
                    {tag}
                    <span class="tc-count">{count}</span>
                  </button>
                );
              })}
            </div>
          </section>
        )
      }
      <Toc />
    </aside>
  </div>

  <script>
    // 点击右侧标签筛选文章（纯前端，不刷新页面）
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.tc-chip'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.post-card'));
    const emptyEl = document.getElementById('tag-empty');
    let active = '';

    const apply = () => {
      let shown = 0;
      for (const card of cards) {
        const tags = (card.dataset.tags || '').split(',').filter(Boolean);
        const ok = !active || tags.includes(active);
        card.style.display = ok ? '' : 'none';
        if (ok) shown++;
      }
      if (emptyEl) emptyEl.hidden = shown > 0;
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        active = chip.dataset.tag || '';
        chips.forEach((c) => c.classList.toggle('is-active', c === chip));
        apply();
      });
    });
  </script>
</Base>
