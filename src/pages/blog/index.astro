---
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const dateFmt = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

// 按正文中文字符数估算阅读时长（约每分钟 400 字）
function minutesRead(post: any): number {
  const body: string = post.body ?? '';
  const chars = body.replace(/\s+/g, '').length;
  return Math.max(1, Math.round(chars / 400));
}
---

<Base title="Blog" description="全部文章列表">
  <div class="container page-wrap">
    <article class="toc-content">
      <header class="page-head">
        <h1>Blog</h1>
        <p>全部文章，共 {posts.length} 篇。</p>
      </header>

      {
        posts.length > 0 ? (
          <div style="margin-top: 36px">
            {posts.map((post) => (
              <a class="post-card" href={`/blog/${post.id}/`}>
                <div class="pc-meta">
                  <span>{dateFmt.format(post.data.date)}</span>
                  {post.data.updated && (
                    <>
                      <span class="pc-sep">/</span>
                      <span>更新 {dateFmt.format(post.data.updated)}</span>
                    </>
                  )}
                  <span class="pc-sep">·</span>
                  <span>{minutesRead(post)} 分钟</span>
                  <span class="pc-sep">·</span>
                  <span>{post.data.language}</span>
                </div>
                <div class="pc-title">{post.data.title}</div>
                {post.data.description && <p class="pc-desc">{post.data.description}</p>}
                {post.data.tags.length > 0 && (
                  <div class="pc-tags">
                    {post.data.tags.map((tag) => <span class="pc-tag">{tag}</span>)}
                  </div>
                )}
              </a>
            ))}
          </div>
        ) : (
          <p style="margin-top: 40px; color: var(--text-muted)">还没有文章。</p>
        )
      }
    </article>
    <aside class="toc-col">
      <Toc />
    </aside>
  </div>
</Base>
