---
import Base from '../layouts/Base.astro';
import Toc from '../components/Toc.astro';
import { links } from '../data/links';
---

<Base title="Links" description="友情链接">
  <div class="container page-wrap">
    <article class="toc-content">
      <header class="page-head">
        <h1>Links</h1>
        <p>朋友们的小站。</p>
      </header>

      <div class="link-grid">
        {
          links.map((link) => (
            <a class="link-card" href={link.url} target="_blank" rel="noopener">
              <span class="link-avatar">
                <span class="link-avatar-fallback" aria-hidden="true">
                  {Array.from(link.name)[0]}
                </span>
                {link.avatar && (
                  <img
                    src={link.avatar}
                    alt=""
                    width="46"
                    height="46"
                    loading="lazy"
                    decoding="async"
                    onerror="this.remove()"
                  />
                )}
              </span>
              <span class="link-body">
                <span class="link-name">{link.name}</span>
                {link.desc && <span class="link-desc">{link.desc}</span>}
              </span>
              <svg
                class="link-arrow"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          ))
        }
      </div>
    </article>
    <aside class="toc-col">
      <Toc />
    </aside>
  </div>
</Base>

<script>
  // 友链点击炫酷跳转：头像从卡片位置缓缓飞到屏幕中央，边飞边放大旋转，
  // 动画完整播完（约 2 秒）后才跳转到目标网站。
  const DURATION = 2000;
  const cards = document.querySelectorAll('.link-card');
  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      // 按住 Ctrl/Cmd 或点鼠标中键时，走浏览器默认行为（新标签页打开）
      if (e.metaKey || e.ctrlKey || e.button !== 0) return;
      e.preventDefault();
      const url = card.getAttribute('href');
      const avatar = card.querySelector('.link-avatar');
      if (!avatar) {
        window.location.href = url;
        return;
      }
      const rect = avatar.getBoundingClientRect();

      // 幽灵头像：克隆一个，固定定位到原位置
      const ghost = avatar.cloneNode(true);
      ghost.classList.add('link-zoom-ghost');
      const gImg = ghost.querySelector('img');
      if (gImg) gImg.removeAttribute('onerror');
      Object.assign(ghost.style, {
        position: 'fixed',
        left: rect.left + 'px',
        top: rect.top + 'px',
        width: rect.width + 'px',
        height: rect.height + 'px',
        margin: '0',
      });
      document.body.appendChild(ghost);

      // 中央光环
      const ring = document.createElement('div');
      ring.className = 'link-zoom-ring';
      document.body.appendChild(ring);

      const cx = window.innerWidth / 2 - rect.left - rect.width / 2;
      const cy = window.innerHeight / 2 - rect.top - rect.height / 2;

      let jumped = false;
      const cleanup = () => {
        ghost.remove();
        ring.remove();
      };
      const go = () => {
        if (jumped) return;
        jumped = true;
        // 跳转前把动画元素全部清掉，避免“返回”时浏览器缓存的页面残留覆盖层
        cleanup();
        window.location.href = url;
      };

      // 关键：等 transform 过渡真正播完（transitionend）才跳转
      ghost.addEventListener('transitionend', (ev) => {
        if (ev.propertyName === 'transform' && ev.target === ghost) go();
      });
      // 兜底：极端情况下 transitionend 没触发，也不能卡住
      setTimeout(go, DURATION + 500);

      // 双 rAF：先渲染初始位置，再切到目标状态，保证过渡动画一定触发
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          ring.classList.add('on');
          ghost.style.transition = `transform ${DURATION}ms cubic-bezier(0.22, 0.8, 0.2, 1), filter ${DURATION}ms ease, box-shadow ${DURATION}ms ease`;
          ghost.style.transform = `translate(${cx}px, ${cy}px) scale(10) rotate(360deg)`;
          ghost.style.filter = 'blur(1px) brightness(1.35)';
          ghost.style.boxShadow = '0 0 120px var(--bg-glow)';
        });
      });
    });
  });

  // 从目标网站“返回”时，若页面被浏览器缓存恢复（bfcache），
  // 清掉可能残留的动画覆盖层，避免出现空白/被遮挡。
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      document
        .querySelectorAll('.link-zoom-ghost, .link-zoom-ring')
        .forEach((el) => el.remove());
    }
  });
</script>
