---
import Base from '../layouts/Base.astro';
import Toc from '../components/Toc.astro';
import { links } from '../data/links';
---

<Base title="Links" description="友情链接">
  <div class="container page-wrap">
    <article class="toc-content">
      <header class="page-head">
        <h1>Links</h1>
        <p>朋友们的小站。</p>
      </header>

      <div class="link-grid">
        {
          links.map((link) => (
            <a class="link-card" href={link.url} target="_blank" rel="noopener">
              <span class="link-avatar">
                <span class="link-avatar-fallback" aria-hidden="true">
                  {Array.from(link.name)[0]}
                </span>
                {link.avatar && (
                  <img
                    src={link.avatar}
                    alt=""
                    width="46"
                    height="46"
                    loading="lazy"
                    decoding="async"
                    onerror="this.remove()"
                  />
                )}
              </span>
              <span class="link-body">
                <span class="link-name">{link.name}</span>
                {link.desc && <span class="link-desc">{link.desc}</span>}
              </span>
              <svg
                class="link-arrow"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          ))
        }
      </div>
    </article>
    <aside class="toc-col">
      <Toc />
    </aside>
  </div>
</Base>

<script>
  // 友链点击炫酷跳转：头像从卡片位置“嗖”地飞到屏幕中央，放大旋转 + 模糊增亮，
  // 中央展开光环，头像快飞到中心时白光一闪，然后跳转目标网站。
  const cards = document.querySelectorAll('.link-card');
  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      // 按住 Ctrl/Cmd 或点鼠标中键时，走浏览器默认行为（新标签页打开）
      if (e.metaKey || e.ctrlKey || e.button !== 0) return;
      e.preventDefault();
      const url = card.getAttribute('href');
      const avatar = card.querySelector('.link-avatar');
      if (!avatar) {
        window.location.href = url;
        return;
      }
      const rect = avatar.getBoundingClientRect();

      // 幽灵头像：克隆一个，固定定位到原位置
      const ghost = avatar.cloneNode(true);
      ghost.classList.add('link-zoom-ghost');
      const gImg = ghost.querySelector('img');
      if (gImg) gImg.removeAttribute('onerror');
      Object.assign(ghost.style, {
        position: 'fixed',
        left: rect.left + 'px',
        top: rect.top + 'px',
        width: rect.width + 'px',
        height: rect.height + 'px',
        margin: '0',
      });
      document.body.appendChild(ghost);

      // 中央光环
      const ring = document.createElement('div');
      ring.className = 'link-zoom-ring';
      document.body.appendChild(ring);

      const cx = window.innerWidth / 2 - rect.left - rect.width / 2;
      const cy = window.innerHeight / 2 - rect.top - rect.height / 2;

      // 双 rAF：先让浏览器渲染出头像在原始位置，再切到目标状态，
      // 保证“飞向中央”的过渡动画一定触发（不会直接跳到终点）。
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          ring.classList.add('on');
          ghost.style.transition =
            'transform 0.5s cubic-bezier(0.6, 0, 0.2, 1), filter 0.5s ease, box-shadow 0.5s ease';
          ghost.style.transform = `translate(${cx}px, ${cy}px) scale(9) rotate(9deg)`;
          ghost.style.filter = 'blur(5px) brightness(1.7)';
          ghost.style.boxShadow = '0 0 90px var(--bg-glow)';
        });
      });

      // 头像快飞到中心时，白光才一闪（避免一上来就是白屏，把飞行动画盖住）
      setTimeout(() => {
        const flash = document.createElement('div');
        flash.className = 'link-zoom-flash';
        document.body.appendChild(flash);
        requestAnimationFrame(() => flash.classList.add('on'));
      }, 340);

      setTimeout(() => {
        window.location.href = url;
      }, 600);
    });
  });
</script>
