---
import Base from '../layouts/Base.astro';
import Toc from '../components/Toc.astro';
import { links } from '../data/links';
---

<Base title="Links" description="友情链接">
  <div class="container page-wrap">
    <article class="toc-content">
      <header class="page-head">
        <h1>Links</h1>
        <p>朋友们的小站。</p>
      </header>

      <div class="link-grid">
        {
          links.map((link) => (
            <a class="link-card" href={link.url} target="_blank" rel="noopener">
              <span class="link-avatar">
                <span class="link-avatar-fallback" aria-hidden="true">
                  {Array.from(link.name)[0]}
                </span>
                {link.avatar && (
                  <img
                    src={link.avatar}
                    alt=""
                    width="46"
                    height="46"
                    loading="lazy"
                    decoding="async"
                    onerror="this.remove()"
                  />
                )}
              </span>
              <span class="link-body">
                <span class="link-name">{link.name}</span>
                {link.desc && <span class="link-desc">{link.desc}</span>}
              </span>
              <svg
                class="link-arrow"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          ))
        }
      </div>
    </article>
    <aside class="toc-col">
      <Toc />
    </aside>
  </div>
</Base>

<script>
  // 友链点击跳转：头像极速飞向屏幕中央，一路擦出摩擦火花，撞到中心爆一圈火花后跳转。
  // 用 requestAnimationFrame 逐帧驱动，满 DURATION 才跳转（不会提前）。
  const DURATION = 720;
  const SPARK_COLORS = ['#ffd166', '#ffb347', '#fff3b0', '#ff8c42', '#ffe9a8'];
  const easeOutExpo = (t) => (t >= 1 ? 1 : 1 - Math.pow(2, -9 * t));
  const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);

  // 在 (x, y) 位置冒一颗火花
  function spark(x, y, spread) {
    const s = document.createElement('span');
    s.className = 'link-spark';
    const size = 2 + Math.random() * 3.5;
    const color = SPARK_COLORS[(Math.random() * SPARK_COLORS.length) | 0];
    Object.assign(s.style, {
      left: x + 'px',
      top: y + 'px',
      width: size + 'px',
      height: size + 'px',
      background: color,
      boxShadow: '0 0 ' + (6 + size * 2) + 'px ' + color,
    });
    document.body.appendChild(s);
    const ang = Math.random() * Math.PI * 2;
    const dist = 14 + Math.random() * spread;
    const dx = Math.cos(ang) * dist;
    const dy = Math.sin(ang) * dist;
    const anim = s.animate(
      [
        { transform: 'translate(-50%,-50%) scale(1)', opacity: 1 },
        {
          transform: 'translate(calc(-50% + ' + dx + 'px), calc(-50% + ' + dy + 'px)) scale(.15)',
          opacity: 0,
        },
      ],
      { duration: 200 + Math.random() * 260, easing: 'cubic-bezier(.12,.7,.2,1)' }
    );
    anim.onfinish = () => s.remove();
  }

  const cards = document.querySelectorAll('.link-card');
  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      // 按住 Ctrl/Cmd 或点鼠标中键时，走浏览器默认行为（新标签页打开）
      if (e.metaKey || e.ctrlKey || e.button !== 0) return;
      e.preventDefault();
      const url = card.getAttribute('href');
      const avatar = card.querySelector('.link-avatar');
      if (!avatar) {
        window.location.href = url;
        return;
      }
      const rect = avatar.getBoundingClientRect();
      const baseX = rect.left + rect.width / 2;
      const baseY = rect.top + rect.height / 2;

      // 幽灵头像
      const ghost = avatar.cloneNode(true);
      ghost.classList.add('link-zoom-ghost');
      const gImg = ghost.querySelector('img');
      if (gImg) gImg.removeAttribute('onerror');
      Object.assign(ghost.style, {
        position: 'fixed',
        left: rect.left + 'px',
        top: rect.top + 'px',
        width: rect.width + 'px',
        height: rect.height + 'px',
        margin: '0',
      });
      document.body.appendChild(ghost);

      // 中心光环
      const ring = document.createElement('div');
      ring.className = 'link-zoom-ring';
      document.body.appendChild(ring);
      requestAnimationFrame(() => ring.classList.add('on'));

      const cx = window.innerWidth / 2 - baseX;
      const cy = window.innerHeight / 2 - baseY;
      const centerX = baseX + cx;
      const centerY = baseY + cy;

      let jumped = false;
      const go = () => {
        if (jumped) return;
        jumped = true;
        ghost.remove();
        ring.remove();
        document.querySelectorAll('.link-spark').forEach((el) => el.remove());
        window.location.href = url;
      };

      let burst = false;
      const start = performance.now();
      const frame = (now) => {
        const t = Math.min(1, (now - start) / DURATION);
        const k = easeOutExpo(t);
        const spin = 900 * easeOutCubic(t);
        ghost.style.transform =
          `translate(${cx * k}px, ${cy * k}px) scale(${1 + 1.8 * k}) rotate(${spin}deg)`;

        // 沿途擦出火花（越接近中心越少）
        const px = baseX + cx * k;
        const py = baseY + cy * k;
        if (t < 0.9) spark(px, py, 60);
        if (t < 0.35) spark(px, py, 36);

        // 快撞到中心时爆一圈火花
        if (!burst && t >= 0.85) {
          burst = true;
          for (let i = 0; i < 16; i++) spark(centerX, centerY, 100);
        }

        if (t < 1) {
          requestAnimationFrame(frame);
        } else {
          go();
        }
      };
      requestAnimationFrame(frame);
    });
  });

  // 从目标网站“返回”时，若页面被浏览器缓存恢复（bfcache），清掉可能残留的动画元素
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      document
        .querySelectorAll('.link-zoom-ghost, .link-zoom-ring, .link-spark')
        .forEach((el) => el.remove());
    }
  });
</script>
