---
import Base from '../layouts/Base.astro';
import Toc from '../components/Toc.astro';
import { links } from '../data/links';
---

<Base title="Links" description="友情链接">
  <div class="container page-wrap">
    <article class="toc-content">
      <header class="page-head">
        <h1>Links</h1>
        <p>朋友们的小站。</p>
      </header>

      <div class="link-grid">
        {
          links.map((link) => (
            <a class="link-card" href={link.url} target="_blank" rel="noopener">
              <span class="link-avatar">
                <span class="link-avatar-fallback" aria-hidden="true">
                  {Array.from(link.name)[0]}
                </span>
                {link.avatar && (
                  <img
                    src={link.avatar}
                    alt=""
                    width="46"
                    height="46"
                    loading="lazy"
                    decoding="async"
                    onerror="this.remove()"
                  />
                )}
              </span>
              <span class="link-body">
                <span class="link-name">{link.name}</span>
                {link.desc && <span class="link-desc">{link.desc}</span>}
              </span>
              <svg
                class="link-arrow"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          ))
        }
      </div>
    </article>
    <aside class="toc-col">
      <Toc />
    </aside>
  </div>
</Base>

<script>
  // 友链点击跳转：头像极速飞向屏幕中央，边飞边被"拉扯"变形（沿运动方向夸张拉伸、垂直压扁），
  // 一路从边缘喷出高温火线火花，撞到中心爆一圈，最后跳转。
  // 全程 requestAnimationFrame 逐帧驱动，满 DURATION 才跳转。
  const DURATION = 720;
  const SPARK_COLORS = ['#fff6c2', '#ffd166', '#ffb347', '#ff9f1c', '#ff6b35'];

  const easeOutExpo = (t) => (t >= 1 ? 1 : 1 - Math.pow(2, -9 * t));
  const clamp = (v, lo, hi) => (v < lo ? lo : v > hi ? hi : v);

  // 一颗「火线」火花：细长条，沿 ang 方向甩出 + 下坠 + 拉长后收缩消失
  function spark(x, y, ang, speed) {
    const s = document.createElement('span');
    s.className = 'link-spark';
    const len = 8 + Math.random() * 16;
    const thick = 1 + Math.random() * 1.9;
    const color = SPARK_COLORS[(Math.random() * SPARK_COLORS.length) | 0];
    Object.assign(s.style, {
      left: x + 'px',
      top: y + 'px',
      width: len + 'px',
      height: thick + 'px',
      marginTop: -(thick / 2) + 'px',
      background: 'linear-gradient(90deg, #ffffff, ' + color + ')',
      boxShadow: '0 0 7px ' + color + ', 0 0 18px ' + color + '66',
    });
    document.body.appendChild(s);
    const dist = speed * (0.55 + Math.random() * 0.95);
    const dur = 230 + Math.random() * 320;
    const drop = 14 + Math.random() * 34;
    s.animate(
      [
        { transform: 'rotate(' + ang + 'rad) translateX(0) scaleX(1)', opacity: 1 },
        {
          transform:
            'rotate(' + ang + 'rad) translateX(' + dist * 0.62 + 'px) translateY(' + drop * 0.35 + 'px) scaleX(0.72)',
          opacity: 0.85,
          offset: 0.6,
        },
        {
          transform:
            'rotate(' + ang + 'rad) translateX(' + dist + 'px) translateY(' + drop + 'px) scaleX(0.06)',
          opacity: 0,
        },
      ],
      { duration: dur, easing: 'linear' }
    ).onfinish = () => s.remove();
  }

  const cards = document.querySelectorAll('.link-card');
  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      // 按住 Ctrl/Cmd 或点鼠标中键时，走浏览器默认行为（新标签页打开）
      if (e.metaKey || e.ctrlKey || e.button !== 0) return;
      e.preventDefault();
      const url = card.getAttribute('href');
      const avatar = card.querySelector('.link-avatar');
      if (!avatar) {
        window.location.href = url;
        return;
      }
      const rect = avatar.getBoundingClientRect();
      const baseX = rect.left + rect.width / 2;
      const baseY = rect.top + rect.height / 2;
      const baseR = rect.width / 2;

      // 幽灵头像（矩阵变换会直接作用在它身上）
      const ghost = avatar.cloneNode(true);
      ghost.classList.add('link-zoom-ghost');
      const gImg = ghost.querySelector('img');
      if (gImg) gImg.removeAttribute('onerror');
      Object.assign(ghost.style, {
        position: 'fixed',
        left: rect.left + 'px',
        top: rect.top + 'px',
        width: rect.width + 'px',
        height: rect.height + 'px',
        margin: '0',
      });
      document.body.appendChild(ghost);

      // 中心光环
      const ring = document.createElement('div');
      ring.className = 'link-zoom-ring';
      document.body.appendChild(ring);
      requestAnimationFrame(() => ring.classList.add('on'));

      const cx = window.innerWidth / 2 - baseX;
      const cy = window.innerHeight / 2 - baseY;

      let jumped = false;
      const go = () => {
        if (jumped) return;
        jumped = true;
        ghost.remove();
        ring.remove();
        document.querySelectorAll('.link-spark').forEach((el) => el.remove());
        window.location.href = url;
      };

      // 运动方向（由上一帧位置差算出来，越准越好）
      let lastX = baseX;
      let lastY = baseY;
      let ux = 1;
      let uy = 0;
      let burst = false;
      const start = performance.now();

      const frame = (now) => {
        const t = Math.min(1, (now - start) / DURATION);
        const k = easeOutExpo(t); // 位移进度：起步极快
        // 自转：整整 5 圈（1800°），t=1 时正好是 360 的整数倍 → 最终回到正位，不会倒着
        const spin = 1800 * (1 - Math.pow(1 - t, 2));

        const px = baseX + cx * k;
        const py = baseY + cy * k;
        const grow = 1 + 3.8 * k; // 整体放大：到中心约 4.8 倍（原来只有 2.8 倍）

        // —— 算出运动方向与速度 ——
        const vx = px - lastX;
        const vy = py - lastY;
        const speed = Math.hypot(vx, vy);
        if (speed > 0.4) {
          ux = vx / speed;
          uy = vy / speed;
        }
        const speedNorm = clamp(speed / 55, 0, 1);

        // —— 线性变换（矩阵）：沿运动方向夸张拉伸 + 垂直方向压扁（面积近似守恒）——
        // 脉动让形变"忽长忽短"，看起来像被高速扯开
        const wob = 0.5 + 0.5 * Math.sin(t * Math.PI * 5);
        const kpar = 1 + 1.3 * speedNorm + 0.55 * wob; // 平行方向：拉伸（峰值约 4.8:1）
        const kperp = 1 / Math.sqrt(kpar); // 垂直方向：压扁
        const sxx = kpar * ux * ux + kperp * (1 - ux * ux);
        const sxy = (kpar - kperp) * ux * uy;
        const syy = kpar * uy * uy + kperp * (1 - uy * uy);
        // 再叠加自转 R，得到最终矩阵 M = R · S
        const r = (spin * Math.PI) / 180;
        const cr = Math.cos(r);
        const sr = Math.sin(r);
        const a = (cr * sxx - sr * sxy) * grow;
        const b = (sr * sxx + cr * sxy) * grow;
        const c = (cr * sxy - sr * syy) * grow;
        const d = (sr * sxy + cr * syy) * grow;
        ghost.style.transform =
          'translate(' + cx * k + 'px,' + cy * k + 'px) matrix(' + a + ',' + b + ',' + c + ',' + d + ',0,0)';

        // —— 越飞越"浓"：提高对比度和饱和度，让浅色头像在高速中显得更扎实 ——
        const ctr = 1 + 1.05 * k; // 对比度 1 → 2.05
        const sat = 1 + 0.75 * k; // 饱和度 1 → 1.75
        const bri = 1 + 0.05 * k;
        ghost.style.filter =
          'contrast(' + ctr.toFixed(3) + ') saturate(' + sat.toFixed(3) + ') brightness(' + bri.toFixed(3) + ')';

        // —— 沿运动反方向，从头像边缘喷火线 ——
        const backAng = Math.atan2(-uy, -ux);
        const emit = t < 0.92 ? (speedNorm > 0.35 ? 2 : 1) : 0;
        for (let i = 0; i < emit; i++) {
          const rim = Math.random() * Math.PI * 2;
          const rad = baseR * grow * 0.82;
          spark(
            px + Math.cos(rim) * rad,
            py + Math.sin(rim) * rad,
            backAng + (Math.random() - 0.5) * 1.6,
            45 + Math.random() * 95
          );
        }

        // —— 快撞到中心时爆一圈火线 ——
        if (!burst && t >= 0.86) {
          burst = true;
          for (let i = 0; i < 28; i++) {
            const ang = Math.random() * Math.PI * 2;
            spark(
              baseX + cx,
              baseY + cy,
              ang,
              90 + Math.random() * 150
            );
          }
        }

        lastX = px;
        lastY = py;
        if (t < 1) {
          requestAnimationFrame(frame);
        } else {
          go();
        }
      };
      requestAnimationFrame(frame);
    });
  });

  // 从目标网站“返回”时，若页面被浏览器缓存恢复（bfcache），清掉可能残留的动画元素
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      document
        .querySelectorAll('.link-zoom-ghost, .link-zoom-ring, .link-spark')
        .forEach((el) => el.remove());
    }
  });
</script>
