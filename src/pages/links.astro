---
import Base from '../layouts/Base.astro';
import Toc from '../components/Toc.astro';
import { links } from '../data/links';
---

<Base title="Links" description="友情链接">
  <div class="container page-wrap">
    <article class="toc-content">
      <header class="page-head">
        <h1>Links</h1>
        <p>朋友们的小站。</p>
      </header>

      <div class="link-grid">
        {
          links.map((link) => (
            <a class="link-card" href={link.url} target="_blank" rel="noopener">
              <span class="link-avatar">
                <span class="link-avatar-fallback" aria-hidden="true">
                  {Array.from(link.name)[0]}
                </span>
                {link.avatar && (
                  <img
                    src={link.avatar}
                    alt=""
                    width="46"
                    height="46"
                    loading="lazy"
                    decoding="async"
                    onerror="this.remove()"
                  />
                )}
              </span>
              <span class="link-body">
                <span class="link-name">{link.name}</span>
                {link.desc && <span class="link-desc">{link.desc}</span>}
              </span>
              <svg
                class="link-arrow"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          ))
        }
      </div>
    </article>
    <aside class="toc-col">
      <Toc />
    </aside>
  </div>
</Base>

<script>
  // 友链点击炫酷跳转：头像飞到屏幕中央 → 边飞边加速旋转 → 到中心高速转 → 慢慢停下 → 跳转。
  // 用 requestAnimationFrame 逐帧驱动，满 2.2 秒、旋转真正停住才跳转。
  const DURATION = 2200; // 总时长
  const T_ARRIVE = 0.42; // 0~42% 飞抵中心并放大，之后只旋转
  const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
  // 旋转曲线：飞向中心时加速，到中心后减速，最后慢慢停住
  const spinCurve = (t) => {
    if (t < T_ARRIVE) {
      const u = t / T_ARRIVE;
      return 0.5 * u * u; // 加速段
    }
    const u = (t - T_ARRIVE) / (1 - T_ARRIVE);
    return 0.5 + 0.5 * (1 - Math.pow(1 - u, 2)); // 减速段
  };

  const cards = document.querySelectorAll('.link-card');
  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      // 按住 Ctrl/Cmd 或点鼠标中键时，走浏览器默认行为（新标签页打开）
      if (e.metaKey || e.ctrlKey || e.button !== 0) return;
      e.preventDefault();
      const url = card.getAttribute('href');
      const avatar = card.querySelector('.link-avatar');
      if (!avatar) {
        window.location.href = url;
        return;
      }
      const rect = avatar.getBoundingClientRect();

      // 幽灵头像：克隆一个，固定定位到原位置
      const ghost = avatar.cloneNode(true);
      ghost.classList.add('link-zoom-ghost');
      const gImg = ghost.querySelector('img');
      if (gImg) gImg.removeAttribute('onerror');
      Object.assign(ghost.style, {
        position: 'fixed',
        left: rect.left + 'px',
        top: rect.top + 'px',
        width: rect.width + 'px',
        height: rect.height + 'px',
        margin: '0',
      });
      document.body.appendChild(ghost);

      // 中央扩散的光环（CSS 过渡自己跑，淡淡的）
      const ring = document.createElement('div');
      ring.className = 'link-zoom-ring';
      document.body.appendChild(ring);
      requestAnimationFrame(() => ring.classList.add('on'));

      const cx = window.innerWidth / 2 - rect.left - rect.width / 2;
      const cy = window.innerHeight / 2 - rect.top - rect.height / 2;

      let jumped = false;
      const go = () => {
        if (jumped) return;
        jumped = true;
        // 跳转前把动画元素全部清掉，避免“返回”时缓存的页面残留覆盖层
        ghost.remove();
        ring.remove();
        window.location.href = url;
      };

      // 逐帧驱动：位移/缩放只在前 42% 完成，旋转全程（加速→减速停下），最后一帧才跳转
      const start = performance.now();
      const frame = (now) => {
        const t = Math.min(1, (now - start) / DURATION);
        const k = easeOutCubic(Math.min(1, t / T_ARRIVE));
        const spin = 1080 * spinCurve(t);
        ghost.style.transform =
          `translate(${cx * k}px, ${cy * k}px) scale(${1 + 1.7 * k}) rotate(${spin}deg)`;
        if (t < 1) {
          requestAnimationFrame(frame);
        } else {
          go();
        }
      };
      requestAnimationFrame(frame);
    });
  });

  // 从目标网站“返回”时，若页面被浏览器缓存恢复（bfcache），
  // 清掉可能残留的动画覆盖层，避免出现空白/被遮挡。
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      document
        .querySelectorAll('.link-zoom-ghost, .link-zoom-ring')
        .forEach((el) => el.remove());
    }
  });
</script>
