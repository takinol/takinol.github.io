---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' });
const PER_PAGE = 8;
---

<Base>
  <!-- 首屏 -->
  <section class="hero">
    <div class="container">
      <img class="avatar-img" src="/avatar.jpg" alt={site.name} />
      <h1>{site.name}</h1>
      <p class="hero-tagline">
        {site.tagline}
        {site.location && <span> · {site.location}</span>}
      </p>
      <div class="hero-links">
        <a class="icon-btn" href={site.links.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
        <a class="icon-btn" href={site.links.email} aria-label="邮箱" title="邮箱">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-10 6L2 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 小人打架：一行像素小人两两对打 -->
  <div class="container">
    <div class="fight-hud" aria-hidden="true">
      <span class="hud-left" id="hud-left">— VS —</span>
      <span class="hud-right" id="hud-right">— VS —</span>
    </div>
    <section class="fight-band" id="fight-band" aria-hidden="true">
      <canvas id="fight-canvas"></canvas>
    </section>
  </div>

  <!-- 全部文章（带翻页） -->
  <div class="container">
    <div class="home-posts">
      <section class="section" id="posts">
        <h2 class="section-title">Posts <span class="section-en">全部文章</span></h2>
        {
          posts.length > 0 ? (
            <>
              <ul class="post-list" id="home-post-list">
                {posts.map((post) => (
                  <li class="post-item">
                    <time class="post-date" datetime={post.data.date.toISOString()}>
                      {fmt.format(post.data.date)}
                    </time>
                    <a class="post-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </li>
                ))}
              </ul>
              <!-- 超过 8 篇才显示翻页器 -->
              <div class="pager" id="home-pager" hidden={posts.length <= PER_PAGE}>
                <button class="pager-btn" id="pager-prev" type="button">← 上一页</button>
                <span class="pager-info" id="pager-info"></span>
                <button class="pager-btn" id="pager-next" type="button">下一页 →</button>
              </div>
            </>
          ) : (
            <p class="post-excerpt">还没有文章，等 takinol 写第一篇吧。</p>
          )
        }
      </section>
    </div>
  </div>

  <script>
    // 首页翻页器：一次显示 8 篇
    const list = document.getElementById('home-post-list');
    if (list) {
      const items = Array.from(list.querySelectorAll('.post-item'));
      const perPage = 8;
      const pages = Math.max(1, Math.ceil(items.length / perPage));
      const info = document.getElementById('pager-info');
      const prev = document.getElementById('pager-prev');
      const next = document.getElementById('pager-next');
      let page = 1;

      function render() {
        items.forEach((el, i) => {
          el.style.display = i >= (page - 1) * perPage && i < page * perPage ? '' : 'none';
        });
        if (info) info.textContent = `第 ${page} / ${pages} 页`;
        if (prev) prev.disabled = page <= 1;
        if (next) next.disabled = page >= pages;
      }

      prev?.addEventListener('click', () => {
        if (page > 1) {
          page--;
          render();
        }
      });
      next?.addEventListener('click', () => {
        if (page < pages) {
          page++;
          render();
        }
      });
      render();
    }
  </script>

  <!-- 小人打架：骨骼动画（逻辑在 src/scripts/fight.ts） -->
  <script>
    import { initFightBand } from '../scripts/fight';
    initFightBand();

    // 方框外的 VS 角标：左上左对、右上右对（读取引擎当前在场角色）
    const hudL = document.getElementById('hud-left') as HTMLElement | null;
    const hudR = document.getElementById('hud-right') as HTMLElement | null;
    const updateHud = () => {
      const names = (window as any).takinolFight?.matchup?.() ?? [];
      if (!hudL || !hudR) return;
      if (names.length >= 4) {
        hudL.textContent = `${names[0]}  VS  ${names[1]}`;
        hudR.textContent = `${names[2]}  VS  ${names[3]}`;
        hudR.style.display = '';
      } else if (names.length === 2) {
        hudL.textContent = `${names[0]}  VS  ${names[1]}`;
        hudR.style.display = 'none';
      }
    };
    updateHud();
    setInterval(updateHud, 400);
  </script>

  <style is:global>
    .fight-hud {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 18px 2px 6px;
      font-family: 'STXingkai', 'Xingkai SC', 'KaiTi', 'STKaiti', 'Microsoft YaHei', serif;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 1px;
    }
    .fight-hud span {
      background: linear-gradient(90deg, #8B7BB8, #C98FB5);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    @media (max-width: 640px) {
      .fight-hud {
        margin-top: 12px;
        font-size: 13px;
      }
    }
  </style>
</Base>
